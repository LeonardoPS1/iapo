---
import { getCollection } from 'astro:content';
import Ranking from '../../layouts/Ranking.astro';

export async function getStaticPaths() {
  const rankings = await getCollection('rankings', ({ data }) => !data.draft);
  return rankings.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---
<Ranking
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  snapshotDate={entry.data.snapshotDate}
  edition={entry.data.edition}
  lists={entry.data.lists}
  method={entry.data.method}
/>