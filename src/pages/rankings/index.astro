---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import MiniPodium from '../../components/rank/MiniPodium.astro';

const allRankings = await getCollection('rankings', ({ data }) => !data.draft);
const rankings = allRankings.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const dateFmt = (d: Date) => new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);

const topRepo = (r: { data: { lists: { items: { rank: number; name: string; metricNumber: number; metricDisplay: string }[] }[] } }) =>
  r.data.lists[0]?.items ?? [];

const collectionPage = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://iapo.cl/rankings#collection',
  name: 'Rankings — iapo.cl',
  description: 'Ranking semanal de repos de GitHub, agent skills y MCP servers.',
  url: 'https://iapo.cl/rankings',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: rankings.map((rank, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `https://iapo.cl/rankings/${rank.id}`,
      name: rank.data.title,
    })),
  },
};
---
<Base title="Rankings" description="Ranking semanal de repos de GitHub, agent skills y MCP servers." structuredData={[collectionPage]}>
  <section class="page-head" data-reveal>
    <span class="eyebrow">// Tendencias</span>
    <h1>Rankings semanales</h1>
    <p class="page-lede">Lo más acompañado en GitHub, lo más instalado en skills.sh y lo más usado en mcp.so — cada semana.</p>
  </section>

  <main class="rank-grid">
    {rankings.map((rank) => (
      <a href={`/rankings/${rank.id}`} class="rank-card panel" data-reveal>
        <header class="rank-card-top">
          <span class="tag">Ranking</span>
          <span class="rank-badge mono">Nº {rank.data.edition}</span>
        </header>
        <h2 class="rank-title" transition:name={`rank-title-${rank.id}`}>{rank.data.title}</h2>
        <MiniPodium items={topRepo(rank)} />
        <footer class="rank-card-foot">
          <span class="eyebrow rank-date">{dateFmt(rank.data.pubDate)}</span>
          <span class="rank-count mono">{rank.data.lists.map((l) => l.items.length).join('·')} puestos</span>
        </footer>
      </a>
    ))}
    {rankings.length === 0 && <p class="empty">Todavía no hay rankings. Vuelve pronto.</p>}
  </main>
</Base>

<style>
  .page-head { padding: 40px 0 30px; }
  .page-head h1 { font-size: clamp(1.9rem, 4vw, 2.3rem); margin: 10px 0 0; }
  .page-lede { color: var(--ink-dim); font-size: 1.05rem; margin: 12px 0 0; max-width: 56ch; }

  .rank-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 18px; margin-bottom: 70px; align-items: start; }
  .rank-card {
    display: block; padding: 24px;
    border-top: 3px solid var(--core);
    transition: transform var(--dur-slow) var(--ease-out), box-shadow var(--dur-slow) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .rank-card:hover { border-top-color: var(--comic-red); box-shadow: 0 18px 36px color-mix(in srgb, var(--core) 12%, transparent); }
  }

  .rank-card-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .rank-badge {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--core);
    background: color-mix(in srgb, var(--core) 8%, var(--paper-raised));
    border: 1px solid color-mix(in srgb, var(--core) 25%, transparent);
    border-radius: 999px;
    padding: 4px 10px;
  }
  .rank-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.22;
    margin: 14px 0 0;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: color 0.15s ease;
  }
  .rank-card:hover .rank-title { color: var(--core); }

  .rank-card-foot {
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
    margin-top: 18px; padding-top: 12px; border-top: 1px dashed var(--rule);
  }
  .rank-date { font-size: 10.5px; }
  .rank-count { color: var(--core); font-size: 11px; font-weight: 700; }
  .empty { color: var(--ink-dim); padding: 20px 0; }
</style>