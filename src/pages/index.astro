---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import Sidebar from '../components/Sidebar.astro';
import HeroArt from '../components/HeroArt.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [featured, ...rest] = posts;

const pilarLabel: Record<string, string> = {
  salud: 'IA en salud',
  automatizacion: 'Automatización',
  'ia-general': 'IA general',
};
const dateFmt = (d: Date) => new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);

// Fecha actual para el masthead (edición dinámica)
const now = new Date();
const mastDay = now.toLocaleDateString('es-CL', { month: 'long' }).toUpperCase();
const mastYear = now.getFullYear().toString();

// Primera publicación: 2026-08-14
const firstPub = new Date('2026-08-14');
const diffMs = now.getTime() - firstPub.getTime();
const mastEditionNum = Math.floor(diffMs / (7 * 24 * 60 * 60 * 1000)) + 1;

const nav = [
  { href: '/blog', label: 'Blog' },
  { href: '/rankings', label: 'Rankings' },
  { href: '/prompts', label: 'Prompts' },
  { href: '/repos', label: 'Repos' },
  { href: '/casos', label: 'Casos' },
  { href: '/sobre', label: 'Sobre' },
];
---
<Base title="Inicio" variant="sheet">

  <div class="loader" data-loader aria-hidden="true">
    <div class="loader-print">
      <span class="loader-wm" aria-hidden="true">
        <span class="wm-ia"><span data-pc>i</span><span data-pc>a</span></span><span class="wm-po"><span data-pc>p</span><span data-pc>o</span></span><span class="wm-tld mono"><span data-pc>.</span><span data-pc>c</span><span data-pc>l</span></span>
      </span>
      <span class="loader-caret" aria-hidden="true">▎</span>
    </div>
    <span class="loader-kicker mono">IMPRIMIENDO EDICIÓN N°{mastEditionNum}…</span>
    <span class="loader-scan" aria-hidden="true"></span>
  </div>

  <article class="sheet" data-sheet>

    <header class="sheet-masthead">
      <div class="mast-row">
        <div class="mast-date mono">
          <span class="mast-day">{mastDay}</span>
          <span class="mast-year">{mastYear}</span>
        </div>
        <a href="/" class="mast-nameplate" aria-label="iapo.cl — inicio" transition:name="masthead-wordmark">
          <Wordmark size={56} />
        </a>
        <div class="mast-edition mono">
          <span class="mast-no">N°{mastEditionNum}</span>
          <span class="mast-loc">VIÑA DEL MAR</span>
        </div>
      </div>
      <div class="mast-rule" aria-hidden="true"></div>
      <nav class="mast-nav" aria-label="Principal">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>

    <section class="hero">
      <span class="hero-kicker mono">// Edición N°{mastEditionNum} · IA aplicada</span>
      <h1 class="hero-h1">
        <span class="hl-line" style="width:64%">Menos hype, más <span class="hl-ia">ia</span><span class="hl-po">po</span>.</span>
        <span class="hl-line" style="width:56%">IA aplicada a lo que haces todos los días.</span>
      </h1>
      <p class="hero-deck">Tips, prompts y skills que probamos en negocios reales — con código, capturas y pasos. Desde Chile.</p>
      <div class="hero-actions">
        <a class="btn" href="#suscribir">Suscribirme gratis</a>
        <a class="btn btn-ghost" href="/blog">Leer el blog →</a>
      </div>
      <HeroArt />
    </section>

    <section class="editorial">
      <h2 class="eyebrow">// En esta edición</h2>
      <span class="stamp stamp-edit" data-reveal data-stamp aria-hidden="true">// IMPRESO</span>
      <div class="ed-list">
        <div class="ed-item">
          <span class="ed-num mono">01</span>
          <div class="ed-body">
            <h3 class="ed-lead">Automatización real</h3>
            <p>Herramientas que corremos en negocios reales — no demos. Cada workflow se explica paso a paso, con código, capturas y casos.</p>
          </div>
        </div>
        <div class="ed-item">
          <span class="ed-num mono">02</span>
          <div class="ed-body">
            <h3 class="ed-lead">Salud primero</h3>
            <p>IA aplicada a clínicas y consultorios: menos carga administrativa, más tiempo para pacientes. Sin inventos, sin promesas de otro planeta.</p>
          </div>
        </div>
        <div class="ed-item">
          <span class="ed-num mono">03</span>
          <div class="ed-body">
            <h3 class="ed-lead">Probado antes de recomendar</h3>
            <p>Cada skill, prompt y repo que publicamos pasó por pruebas reales antes de llegar a esta hoja.</p>
          </div>
        </div>
      </div>
    </section>

    <hr class="sheet-rule" aria-hidden="true" />

    <div class="mag-grid">
      <section class="mag-main">
        <div class="section-head" data-reveal>
          <span class="stamp stamp-core" data-reveal data-stamp aria-hidden="true">// PORTADA</span>
          <span class="eyebrow">// Portada</span>
          <h2>Última transmisión</h2>
        </div>

        {featured && (
          <a href={`/blog/${featured.id}`} class="featured panel" data-reveal>
            <div class="featured-meta">
              <span class="tag" data-pilar={featured.data.pilar}>{pilarLabel[featured.data.pilar]}</span>
              <span class="eyebrow">{dateFmt(featured.data.pubDate)}</span>
            </div>
            <h3 class="featured-title">{featured.data.title}</h3>
            <p class="featured-desc">{featured.data.description}</p>
            <span class="featured-cta mono">Leer artículo →</span>
          </a>
        )}

        {rest.length > 0 && (
          <div class="more-list">
            {rest.map((post) => (
              <a href={`/blog/${post.id}`} class="post-row" data-reveal>
                <span class="tag" data-pilar={post.data.pilar}>{pilarLabel[post.data.pilar]}</span>
                <span class="post-row-title">{post.data.title}</span>
                <span class="eyebrow">{dateFmt(post.data.pubDate)}</span>
              </a>
            ))}
          </div>
        )}

        {posts.length === 0 && <p class="empty">Todavía no hay publicaciones. Vuelve pronto.</p>}
      </section>

      <Sidebar posts={posts} />
    </div>

    <hr class="sheet-rule" aria-hidden="true" />

    <section id="suscribir" class="subscribe panel" data-reveal>
      <span class="stamp stamp-sub" data-reveal data-stamp aria-hidden="true">// TIRAJE</span>
      <div class="subscribe-inner">
        <span class="eyebrow">// Frecuencia semanal</span>
        <h2>No te pierdas la próxima señal</h2>
        <p class="lede">3 tips útiles, 1 repo curado, 1 caso real. Cada semana en tu correo.</p>
        <iframe class="subscribe-embed" src="https://db52c710.sibforms.com/v2/serve/MUIFAKic_WyWOrVE9GUip8G9Zf9qyNoxJhhvNUkXecG5PT0knZjrfYkCXXjhZfrS0BFhekQQOd1S7ZwbvzVBX2H_46ZjDWVex0ww638t5ImFAeSuY7x5lUEK5lzfxqyHpy8COFmWpQFlW5ZY_vBmhrcc8bX0uvuWUZFEbJSLmZUzccR6Ds00U209QSAz0ACrXcdpXGpMg1tPi2MPlQ==" width="540" height="305" frameborder="0" scrolling="auto" allowfullscreen title="Formulario de suscripción al newsletter"></iframe>
      </div>
    </section>

  </article>
</Base>

<style>
  /* ===== Loader ===== */
  .loader {
    position: fixed; inset: 0; z-index: 50;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18px;
    background: var(--ink); color: var(--paper);
    opacity: 1; visibility: visible;
    transition: opacity 0.7s var(--ease-out), visibility 0.7s var(--ease-out);
  }
  .loader.is-gone { opacity: 0; visibility: hidden; }
  .loader-kicker {
    font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--ink-faint);
    animation: pulse 1.5s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .loader-kicker { animation: none; opacity: 1; }
  }

  /* ===== Loader: imprenta (impresión carácter a carácter + barrido) ===== */
  .loader { overflow: hidden; }
  .loader-print {
    display: inline-flex; align-items: baseline; gap: 6px;
    font-family: var(--font-nameplate); font-weight: 700;
    font-size: 40px; line-height: 1; letter-spacing: -0.01em;
  }
  .loader-wm { display: inline-flex; align-items: baseline; }
  .loader-wm [data-pc] { opacity: 0; }
  .loader-wm .wm-ia { color: var(--paper); }
  .loader-wm .wm-po {
    display: inline-block; color: var(--comic-red);
    transform: rotate(-6deg); margin-left: 0.03em;
  }
  .loader-wm .wm-tld {
    font-family: var(--font-mono); font-size: 0.34em; font-weight: 400;
    color: #9ca0a6; align-self: flex-end;
    margin-left: 0.2em; margin-bottom: 0.05em;
  }
  .loader-caret {
    color: var(--core-bright); font-family: var(--font-mono);
    font-size: 18px; line-height: 1; opacity: 0;
  }
  .loader-scan {
    position: absolute; left: 0; top: 0; width: 100%; height: 26vh;
    border-top: 2px solid var(--core-bright);
    background: linear-gradient(rgba(10, 114, 96, 0.5), rgba(10, 114, 96, 0));
    opacity: 0.3;
    transform: translateY(-120%);
    pointer-events: none;
  }

  /* ===== Sheet ===== */
  .sheet {
    position: relative;
    background: var(--paper);
    color: var(--ink);
    max-width: 840px;
    margin: 0 auto;
    padding: 44px 56px 52px;
    border-radius: 2px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.45), 0 2px 8px rgba(0, 0, 0, 0.3);
    opacity: 0;
    transform: scale(0.97);
    transform-origin: center;
    transition: opacity var(--dur-reveal) var(--ease-out), transform var(--dur-reveal) var(--ease-out);
  }
  .sheet.is-revealed { opacity: 1; transform: scale(1); }

  /* ===== Masthead entrance stagger ===== */
  .mast-date,
  .mast-nameplate,
  .mast-edition,
  .mast-nav {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity var(--dur-reveal) var(--ease-out), transform var(--dur-reveal) var(--ease-out);
  }
  .mast-date { transition-delay: 0ms; }
  .mast-nameplate { transition-delay: 80ms; }
  .mast-edition { transition-delay: 160ms; }
  .mast-nav { transition-delay: 240ms; }
  .sheet.is-revealed .mast-date,
  .sheet.is-revealed .mast-nameplate,
  .sheet.is-revealed .mast-edition,
  .sheet.is-revealed .mast-nav { opacity: 1; transform: translateY(0); }

  .mast-row { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
  .mast-nameplate { text-align: center; text-decoration: none; }
  .mast-nameplate:hover { text-decoration: none; }
  .mast-date, .mast-edition { display: flex; flex-direction: column; gap: 2px; }
  .mast-date { align-items: flex-start; }
  .mast-edition { align-items: flex-end; }
  .mast-day { font-size: 13px; font-weight: 700; letter-spacing: 0.14em; }
  .mast-year { font-size: 11px; color: var(--ink-faint); letter-spacing: 0.2em; }
  .mast-no { font-size: 11px; color: var(--comic-red); font-weight: 700; letter-spacing: 0.14em; }
  .mast-loc { font-size: 11px; color: var(--ink-faint); letter-spacing: 0.1em; }
  .mast-rule {
    height: 2px; margin: 18px 0 0;
    background-image: repeating-linear-gradient(90deg, var(--ink) 0 2px, transparent 2px 7px);
  }
  .mast-nav {
    display: flex; justify-content: center; gap: 26px; padding: 12px 0 4px;
    font-family: var(--font-mono); font-size: 12px; font-weight: 700;
  }
  .mast-nav a {
    color: var(--ink-dim); letter-spacing: 0.04em; text-decoration: none; position: relative;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .mast-nav a::after {
    content: ''; position: absolute; left: 0; bottom: -3px;
    width: 0; height: 1.5px; background: var(--core);
    transition: width var(--dur-base) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .mast-nav a:hover { color: var(--ink); text-decoration: none; }
    .mast-nav a:hover::after { width: 100%; }
  }
  .mast-nav a:focus-visible,
  .mast-nameplate:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--core), 0 0 0 4px var(--paper);
    border-radius: 2px;
  }

  /* ===== Hero ===== */
  .hero { position: relative; padding: 40px 0 8px; }
  .hero-kicker {
    display: inline-block;
    font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--comic-red);
    padding: 5px 10px;
    border: 1px solid var(--comic-red);
    border-radius: 999px;
    background: var(--paper);
    margin-bottom: 20px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out);
    transition-delay: 320ms;
  }
  .sheet.is-revealed .hero-kicker { opacity: 1; transform: translateY(0); }
  .hero-h1 { font-family: var(--font-display); font-weight: 600; line-height: 1.04; letter-spacing: -0.015em; margin: 0; }
  .hl-line { display: block; max-width: 100%; }
  .hl-line:nth-child(1) { font-size: clamp(2.5rem, 6.6vw, 4.1rem); }
  .hl-line:nth-child(2) { font-size: clamp(2.3rem, 6vw, 3.8rem); color: var(--ink-dim); }
  .hl-ia { color: var(--ink); }
  .hl-po { color: var(--comic-red); display: inline-block; transform: rotate(-3deg); }

  .hl-line {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out);
  }
  .hl-line.is-in { opacity: 1; transform: translateY(0); }

  .hero-deck {
    max-width: 52ch;
    margin: 18px 0 0;
    color: var(--ink-dim);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 28px; }

  /* ===== HeroArt entrance ===== */
  .hero-art {
    margin-top: 32px;
  }

  /* ===== Editorial ===== */
  .editorial { padding: 34px 0 6px; border-top: 2px solid var(--ink); }
  .ed-list { margin: 18px 0 0; }
  .ed-item {
    display: grid; grid-template-columns: auto 1fr; gap: 18px;
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out);
  }
  .ed-item:last-child { border-bottom: none; }
  .ed-item:nth-child(1) { transition-delay: 400ms; }
  .ed-item:nth-child(2) { transition-delay: 460ms; }
  .ed-item:nth-child(3) { transition-delay: 520ms; }
  .sheet.is-revealed .ed-item { opacity: 1; transform: translateY(0); }
  .ed-num {
    font-size: 13px; font-weight: 700; color: var(--comic-red);
    padding-top: 3px;
  }
  .ed-body p { margin: 6px 0 0; color: var(--ink-dim); font-size: 0.97rem; line-height: 1.6; }
  .ed-lead { font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; margin: 0; }

  /* ===== Buttons ===== */
  .btn {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.02em;
    padding: 12px 22px;
    border-radius: 999px;
    background: var(--core);
    color: var(--paper-raised);
    border: 1px solid var(--core);
    text-decoration: none;
    font-weight: 700;
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      filter var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .btn:hover {
      text-decoration: none;
      transform: translateY(-1px);
      box-shadow: 0 10px 20px rgba(14, 138, 118, 0.25);
      filter: brightness(1.05);
    }
  }
  .btn:active {
    transform: scale(0.97);
    transition-duration: var(--dur-fast);
  }
  .btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--core), 0 0 0 4px var(--paper);
  }

  .btn-ghost {
    background: transparent;
    border: 1px solid var(--rule-strong);
    color: var(--ink);
  }
  @media (hover: hover) and (pointer: fine) {
    .btn-ghost:hover {
      box-shadow: none;
      border-color: var(--ink);
      background: var(--paper-raised);
    }
  }
  .btn-ghost:active {
    transform: scale(0.97);
    transition-duration: var(--dur-fast);
  }
  .btn-ghost:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--core), 0 0 0 4px var(--paper);
  }

  .sheet-rule {
    border: none; height: 2px; margin: 40px 0;
    background-image: repeating-linear-gradient(90deg, var(--ink) 0 2px, transparent 2px 7px);
    opacity: 0.3;
  }

  .mag-grid { display: grid; grid-template-columns: 1fr 280px; gap: 40px; align-items: start; }

  .section-head { margin-bottom: 22px; }
  .section-head h2 { font-size: 1.4rem; margin-top: 6px; }

  /* ===== Featured article ===== */
  .featured {
    display: block; padding: 26px; margin-bottom: 28px;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out);
    transition-delay: 580ms;
  }
  .sheet.is-revealed .featured { opacity: 1; transform: translateY(0); }
  .featured-meta { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .featured-title { font-size: 1.5rem; margin: 0 0 12px; line-height: 1.25; }
  .featured-desc { color: var(--ink-dim); font-size: 1rem; line-height: 1.6; margin: 0 0 18px; }
  .featured-cta { font-size: 12.5px; font-weight: 700; color: var(--core); }
  @media (hover: hover) and (pointer: fine) {
    .featured:hover {
      text-decoration: none;
      transform: translateY(-2px);
      box-shadow: 0 16px 32px rgba(21, 23, 28, 0.1);
      border-color: var(--core);
    }
  }
  .featured:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--core), 0 0 0 4px var(--paper);
    border-radius: 8px;
  }

  /* ===== Post rows ===== */
  .more-list { display: flex; flex-direction: column; }
  .post-row {
    display: flex; align-items: center; gap: 14px;
    padding: 16px 4px;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
    transition:
      transform var(--dur-base) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .post-row:hover {
      text-decoration: none;
      transform: translateX(4px);
    }
    .post-row:hover .post-row-title { color: var(--core); }
  }
  .post-row:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--core), 0 0 0 4px var(--paper);
    border-radius: 4px;
  }
  .post-row:nth-child(1) { transition-delay: 640ms; }
  .post-row:nth-child(2) { transition-delay: 700ms; }
  .post-row:nth-child(3) { transition-delay: 760ms; }
  .post-row:nth-child(4) { transition-delay: 820ms; }
  .post-row:nth-child(5) { transition-delay: 880ms; }
  .sheet.is-revealed .post-row { opacity: 1; transform: translateY(0); }
  .post-row-title { flex: 1; font-size: 1rem; font-weight: 500; transition: color var(--dur-fast) var(--ease-out); }
  .empty { color: var(--ink-dim); padding: 20px 0; }

  /* ===== Subscribe ===== */
  .subscribe {
    padding: 0; margin: 0;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 500ms var(--ease-out), transform 500ms var(--ease-out);
    transition-delay: 800ms;
  }
  .sheet.is-revealed .subscribe { opacity: 1; transform: translateY(0); }
  .subscribe-inner { padding: 36px 32px; }
  .subscribe h2 { font-size: 1.5rem; margin: 10px 0 10px; }
  .subscribe-embed {
    display: block;
    width: 100%;
    max-width: 540px;
    height: 305px;
    margin: 22px 0 0;
    border: none;
  }

  /* ===== Sellos de goma — base visual (scale/rotate los da [data-stamp] global) ===== */
  .editorial, .section-head, .subscribe { position: relative; }
  .stamp {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 9px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--comic-red);
    border: 1.5px dashed var(--comic-red);
    border-radius: 3px;
    padding: 5px 8px 4px;
    background: var(--paper);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    z-index: 2;
  }
  .stamp-edit { top: -15px; right: -6px; }
  .stamp-core { top: -12px; right: 0; color: var(--core); border-color: var(--core); }
  .stamp-sub { bottom: 14px; right: 22px; }

  /* ===== Reduced motion ===== */
  @media (prefers-reduced-motion: reduce) {
    .loader-kicker { animation: none; opacity: 1; }
    .loader-scan, .loader-caret { display: none; }
    .sheet,
    .mast-date, .mast-nameplate, .mast-edition, .mast-nav,
    .hero-kicker,
    .hl-line,
    .ed-item,
    .featured,
    .post-row,
    .subscribe,
    .hero-art {
      transition-duration: 0ms !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }

  @media (max-width: 860px) {
    .sheet { padding: 32px 28px 40px; }
    .mast-nav { gap: 16px; flex-wrap: wrap; }
    .mag-grid { grid-template-columns: 1fr; }
    .mast-nav a { padding: 4px 0; }
  }
</style>

<script>
  import { animate, stagger, scroll } from 'motion';

  // Con ClientRouter los scripts bundled corren una sola vez; todo el
  // arranque de la home vive en `astro:page-load` para re-ejecutarse
  // en cada navegación (fuente: docs.astro.build/en/guides/view-transitions/).

  // Estado compartido entre re-ejecuciones (SPA): anulamos animaciones previas.
  let runId = 0;
  let activeCtrls = [];
  let stopTint = null;

  // Primer entintado: #606369 (ink-faint) → #15171c (ink)
  const INK_FAINT = [96, 99, 105];
  const INK = [21, 23, 28];
  const mix = (a, b, p) => [0, 1, 2].map((i) => Math.round(a[i] + (b[i] - a[i]) * p));

  function initIndex() {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const loader = document.querySelector('[data-loader]');
    const sheet = document.querySelector('[data-sheet]');
    const lines = document.querySelectorAll('.hl-line');

    // ——— limpiar animaciones de una navegación SPA previa ———
    const id = ++runId;
    activeCtrls.forEach((ctrl) => { try { ctrl.stop(); } catch { /* ya terminó */ } });
    activeCtrls = [];
    if (stopTint) { stopTint(); stopTint = null; }

    function revealSheet() {
      if (loader) loader.classList.add('is-gone');
      if (sheet) sheet.classList.add('is-revealed');
      lines.forEach((line, i) => {
        setTimeout(() => line.classList.add('is-in'), 200 + i * 120);
      });
    }

    // Actualizar masthead dinámicamente en cliente (fecha actual + edición desde 1ra pub)
    function updateMasthead() {
      const now = new Date();
      const firstPub = new Date('2026-08-14');
      const diffMs = now.getTime() - firstPub.getTime();
      const editionNum = Math.floor(diffMs / (7 * 24 * 60 * 60 * 1000)) + 1;
      const month = now.toLocaleDateString('es-CL', { month: 'long' }).toUpperCase();
      const year = now.getFullYear().toString();

      const mastDay = document.querySelector('.mast-day');
      const mastYear = document.querySelector('.mast-year');
      const mastNo = document.querySelector('.mast-no');
      const loaderKicker = document.querySelector('.loader-kicker');
      const heroKicker = document.querySelector('.hero-kicker');

      if (mastDay) mastDay.textContent = month;
      if (mastYear) mastYear.textContent = year;
      if (mastNo) mastNo.textContent = `N°${editionNum}`;
      if (loaderKicker) loaderKicker.textContent = `IMPRIMIENDO EDICIÓN N°${editionNum}…`;
      if (heroKicker) heroKicker.textContent = `// Edición N°${editionNum} · IA aplicada`;
    }

    updateMasthead();

    if (reduceMotion) {
      if (loader) loader.remove();
      if (sheet) sheet.classList.add('is-revealed');
      lines.forEach((line) => line.classList.add('is-in'));
      // Force reveal all staggered elements
      document.querySelectorAll('.mast-date, .mast-nameplate, .mast-edition, .mast-nav, .hero-kicker, .ed-item, .featured, .post-row, .subscribe, .hero-art').forEach(el => {
        el.style.transitionDuration = '0ms';
        el.style.opacity = '1';
        el.style.transform = 'none';
      });
      return;
    }

    // ——— Fase 1: secuencia de imprenta ———
    const pc = Array.from(document.querySelectorAll('.loader-wm [data-pc]'));
    const caret = document.querySelector('.loader-caret');
    const scan = document.querySelector('.loader-scan');

    if (pc.length && loader) {
      // Caret parpadea mientras imprime
      if (caret) {
        const blink = animate(caret, { opacity: [0, 1, 1, 0] }, { duration: 0.6, repeat: Infinity, ease: 'easeInOut' });
        activeCtrls.push(blink);
      }

      // El wordmark se imprime carácter a carácter
      const print = animate(pc, { opacity: 1 }, {
        delay: stagger(0.05, { startDelay: 0.15, from: 0 }),
        duration: 0.2,
        ease: 'easeOut',
      });
      activeCtrls.push(print);

      print.finished.then(() => {
        if (id !== runId) return;
        if (caret) {
          const out = animate(caret, { opacity: 0 }, { duration: 0.2, ease: 'easeOut' });
          activeCtrls.push(out);
        }
        if (scan) {
          // Barrido de la rotativa: una pasada de arriba a abajo
          const roller = animate(
            scan,
            { transform: ['translateY(-120%)', 'translateY(118vh)'] },
            { duration: 0.75, ease: [0.16, 1, 0.3, 1] }
          );
          activeCtrls.push(roller);
          return roller.finished;
        }
      }).then(() => {
        if (id !== runId) return;
        revealSheet();
      });
    } else {
      revealSheet();
    }

    // ——— Fase 2: el titular se entinta con el scroll ———
    // Target: .hero (no la sheet completa). Así p llega a su fin cuando el
    // titular recorre la parte alta del viewport y se ve nítido al leerlo.
    const hero = document.querySelector('.hero') || sheet;
    if (hero && lines.length && typeof scroll === 'function') {
      stopTint = scroll((p) => {
        const c = mix(INK_FAINT, INK, p);
        const blur = 2 * (1 - p);
        lines.forEach((line) => {
          line.style.color = `rgb(${c[0]}, ${c[1]}, ${c[2]})`;
          line.style.filter = blur > 0.05 ? `blur(${blur.toFixed(2)}px)` : 'none';
        });
      }, { target: hero, offset: ['start 1.2', 'start 0.25'] });
    }
  }

  // astro:page-load dispara en la primera carga Y tras cada navegación SPA
  initIndex();
  document.addEventListener('astro:page-load', initIndex);
</script>