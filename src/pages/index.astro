---
import Base from '../layouts/Base.astro';
import PulseLine from '../components/PulseLine.astro';
import NeuralCore from '../components/NeuralCore.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 6);

const pilarLabel: Record<string, string> = {
  salud: 'IA en salud',
  automatizacion: 'Automatización',
  'ia-general': 'IA general',
};
const dateFmt = (d: Date) => new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);
---
<Base title="Inicio">
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-text">
        <span class="status-pill"><span class="status-dot"></span>SEÑAL ACTIVA · VIÑA DEL MAR, CL</span>
        <h1>Tips, prompts y repos<br /><em>que sí usamos.</em></h1>
        <p class="lede">
          Un espacio para practicantes, no para hype: automatización, IA aplicada a salud y las
          herramientas que probamos antes de recomendarlas. Sin traducciones genéricas del inglés.
        </p>
        <div class="hero-actions">
          <a class="btn" href="#suscribir">Suscribirme</a>
          <a class="btn btn-ghost" href="/blog">Ver todo el blog →</a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <NeuralCore size={380} />
      </div>
    </div>
    <div class="hero-trace"><PulseLine height={70} cycles={4} /></div>
  </section>

  <hr />

  <section class="latest">
    <div class="section-head" data-reveal>
      <span class="eyebrow">// Últimas transmisiones</span>
      <h2>Publicaciones recientes</h2>
    </div>
    <div class="post-grid">
      {posts.map((post) => (
        <a href={`/blog/${post.id}`} class="post-card bracket-card" data-reveal>
          <span class="tag" data-pilar={post.data.pilar}>{pilarLabel[post.data.pilar]}</span>
          <h3 class="post-title">{post.data.title}</h3>
          <p class="post-desc">{post.data.description}</p>
          <span class="eyebrow post-date">{dateFmt(post.data.pubDate)}</span>
        </a>
      ))}
      {posts.length === 0 && <p class="empty">Todavía no hay publicaciones. Vuelve pronto.</p>}
    </div>
  </section>

  <hr />

  <section id="suscribir" class="subscribe bracket-card" data-reveal>
    <div class="subscribe-inner">
      <span class="eyebrow">// Frecuencia semanal</span>
      <h2>No te pierdas la próxima señal</h2>
      <p class="lede">Un correo a la semana: 3 tips, 1 repo curado, 1 caso de uso real.</p>
      <form class="subscribe-form" action="https://newsletter.iapo.cl/subscription/form" method="post">
        <input type="email" name="email" placeholder="tu@correo.cl" required aria-label="Correo electrónico" />
        <button type="submit">Suscribirme</button>
      </form>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 56px 0 20px; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 24px;
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(2.3rem, 4.6vw, 3.3rem);
    margin: 20px 0 18px;
    max-width: 15ch;
  }
  .hero h1 em { color: var(--core); font-style: italic; font-weight: 400; }
  .lede { color: var(--text-dim); font-size: 1.08rem; max-width: 52ch; margin: 0; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 30px; }
  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .hero-trace { margin: 44px 0 28px; opacity: 0.9; }

  .btn {
    font-family: var(--font-mono);
    font-size: 13.5px;
    letter-spacing: 0.02em;
    padding: 11px 20px;
    border-radius: var(--radius);
    background: var(--core);
    color: #071410;
    text-decoration: none;
    font-weight: 700;
    transition: filter 0.2s ease, transform 0.2s ease;
  }
  .btn:hover { text-decoration: none; filter: brightness(1.12); transform: translateY(-1px); }
  .btn-ghost {
    background: transparent;
    border: 1px solid var(--border-bright);
    color: var(--text);
    font-weight: 400;
  }
  .btn-ghost:hover { border-color: var(--core); }

  .section-head { margin-bottom: 26px; }
  .section-head h2 { font-size: 1.5rem; margin-top: 8px; }

  .post-grid { display: grid; gap: 16px; }
  .post-card { display: block; padding: 22px; color: var(--text); text-decoration: none; }
  .post-card:hover { text-decoration: none; }
  .post-title { font-size: 1.15rem; margin: 12px 0 8px; font-weight: 500; transition: color 0.2s ease; }
  .post-card:hover .post-title { color: var(--core); }
  .post-desc { color: var(--text-dim); font-size: 0.95rem; margin: 0 0 14px; line-height: 1.55; }
  .empty { color: var(--text-dim); padding: 20px 0; }

  .subscribe { padding: 0; margin: 40px 0 60px; }
  .subscribe-inner { padding: 36px 32px; }
  .subscribe h2 { font-size: 1.5rem; margin: 10px 0 10px; }
  .subscribe-form { display: flex; gap: 10px; margin-top: 22px; max-width: 440px; flex-wrap: wrap; }
  .subscribe-form input {
    flex: 1;
    min-width: 200px;
    background: var(--bg);
    border: 1px solid var(--border-bright);
    border-radius: var(--radius);
    padding: 11px 13px;
    color: var(--text);
    font-family: var(--font-body);
  }
  .subscribe-form input:focus { outline: 2px solid var(--core); outline-offset: 1px; }
  .subscribe-form button {
    font-family: var(--font-mono);
    font-weight: 700;
    background: var(--core);
    color: #071410;
    border: none;
    border-radius: var(--radius);
    padding: 11px 20px;
    cursor: pointer;
    transition: filter 0.2s ease;
  }
  .subscribe-form button:hover { filter: brightness(1.12); }

  @media (max-width: 760px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { order: -1; margin-bottom: 8px; }
    .hero-visual :global(.core-wrap) { width: 220px; }
    .hero h1 { max-width: none; }
  }
</style>
