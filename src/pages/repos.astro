---
import Base from '../layouts/Base.astro';

const repos = [
  {
    nombre: 'n8n-io/n8n',
    desc: 'Motor de automatización low-code que usamos en producción para flujos de calificación de leads y notificaciones.',
    url: 'https://github.com/n8n-io/n8n',
  },
  {
    nombre: 'evolution-api/evolution-api',
    desc: 'Gateway no oficial de WhatsApp. Útil en desarrollo; para producción preferimos Meta Cloud API por riesgo de ban.',
    url: 'https://github.com/EvolutionAPI/evolution-api',
  },
  {
    nombre: 'listmonk/listmonk',
    desc: 'Newsletter self-hosted, alternativa liviana a Mailchimp para quienes ya operan su propio VPS.',
    url: 'https://github.com/knadh/listmonk',
  },
  {
    nombre: 'open-webui/open-webui',
    desc: 'Interfaz de chat self-hosted para modelos locales vía Ollama. La usamos para dar acceso interno al equipo a los modelos que corremos en el VPS, sin exponer una API cruda ni requerir terminal.',
    url: 'https://github.com/open-webui/open-webui',
  },
];
---
<Base title="Repos" description="Repositorios open source que probamos antes de recomendarlos.">
  <section class="page-head" data-reveal>
    <span class="eyebrow">// Curaduría de código</span>
    <h1>Repos</h1>
    <p class="lede">Herramientas open source que evaluamos con uso real, no solo por estrellas en GitHub.</p>
  </section>

  <div class="repo-list">
    {repos.map((r) => (
      <a href={r.url} target="_blank" rel="noopener" class="repo-card panel" data-reveal>
        <span class="repo-name mono">{r.nombre} ↗</span>
        <p>{r.desc}</p>
      </a>
    ))}
  </div>
</Base>

<style>
  .page-head { padding: 40px 0 10px; }
  .page-head h1 { font-size: clamp(1.9rem, 4vw, 2.3rem); margin: 10px 0 14px; }
  .lede { color: var(--ink-dim); max-width: 55ch; margin: 0; }
  .repo-list { display: flex; flex-direction: column; gap: 18px; margin: 34px 0 70px; max-width: 780px; }
  .repo-card { display: block; padding: 20px 22px; color: var(--ink); text-decoration: none; }
  .repo-card:hover { text-decoration: none; }
  .repo-name { font-size: 1rem; color: var(--core); transition: filter 0.15s ease; }
  .repo-card:hover .repo-name { filter: brightness(1.15); }
  .repo-card p { color: var(--ink-dim); margin: 10px 0 0; }
</style>
