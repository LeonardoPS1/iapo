---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allRepos = await getCollection('library', ({ data }) => data.kind === 'repo' && !data.draft);
const repos = allRepos.sort((a, b) => a.data.order - b.data.order);

const collectionPage = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://iapo.cl/repos#collection',
  name: 'Repos — iapo.cl',
  description: 'Herramientas open source evaluadas con uso real.',
  url: 'https://iapo.cl/repos',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: repos.map((repo, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: repo.data.url,
      name: repo.data.repo ?? repo.data.title,
    })),
  },
};
---
<Base title="Repos" description="Herramientas open source que probamos antes de recomendarlos." structuredData={[collectionPage]}>
  <section class="page-head" data-reveal>
    <span class="eyebrow">// Curaduría de código</span>
    <h1>Repos</h1>
    <p class="lede">Herramientas open source que evaluamos con uso real, no solo por estrellas en GitHub.</p>
  </section>

  <div class="repo-list">
    {repos.map((repo) => (
      <a href={repo.data.url} target="_blank" rel="noopener" class="repo-card panel" data-reveal>
        <span class="repo-name mono">{repo.data.title} ↗</span>
        <p>{repo.data.description}</p>
      </a>
    ))}
  </div>

  {repos.length === 0 && (
    <div class="soon panel" data-reveal>
      <p class="mono">→ primer repo en camino</p>
    </div>
  )}
</Base>

<style>
  .page-head { padding: 40px 0 10px; }
  .page-head h1 { font-size: clamp(1.9rem, 4vw, 2.3rem); margin: 10px 0 14px; }
  .lede { color: var(--ink-dim); max-width: 55ch; margin: 0; }
  .repo-list { display: flex; flex-direction: column; gap: 18px; margin: 34px 0 70px; max-width: 780px; }
  .repo-card { display: block; padding: 20px 22px; color: var(--ink); text-decoration: none; }
  .repo-card:hover { text-decoration: none; }
  .repo-name { font-size: 1rem; color: var(--core); transition: filter 0.15s ease; }
  .repo-card:hover .repo-name { filter: brightness(1.15); }
  .repo-card p { color: var(--ink-dim); margin: 10px 0 0; }
  .soon { max-width: 780px; margin: 34px 0 70px; padding: 40px 32px; text-align: center; }
  .soon p { color: var(--ink-faint); margin: 0; }
</style>
