---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPrompts = await getCollection('library', ({ data }) => data.kind === 'prompt' && !data.draft);
const prompts = allPrompts.sort((a, b) => a.data.order - b.data.order);

const pilarLabel: Record<string, string> = { salud: 'IA en salud', automatizacion: 'Automatización', 'ia-general': 'IA general' };

const slug = (value: string) => value.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const collectionPage = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://iapo.cl/prompts#collection',
  name: 'Prompts — iapo.cl',
  description: 'Prompts probados en producción para clínicas y automatización con IA.',
  url: 'https://iapo.cl/prompts',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: prompts.map((prompt, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `https://iapo.cl/prompts#${slug(prompt.data.title)}`,
      name: prompt.data.title,
    })),
  },
};
---
<Base title="Prompts" description="Prompts probados en producción para clínicas y automatización con IA." structuredData={[collectionPage]}>
  <section class="page-head" data-reveal>
    <span class="eyebrow">// Recorta y usa</span>
    <h1>Prompts</h1>
    <p class="lede">Prompts que usamos en producción, no genéricos de Twitter. Cópialos y ajusta lo que está entre llaves.</p>
  </section>

  <div class="prompt-list">
    {prompts.map((p) => (
      <article class="prompt-card coupon" data-reveal>
        <div class="prompt-head">
          <h2>{p.data.title}</h2>
          {p.data.pilar && <span class="tag" data-pilar={p.data.pilar}>{pilarLabel[p.data.pilar]}</span>}
        </div>
        <pre><code>{p.data.text}</code></pre>
      </article>
    ))}
  </div>

  {prompts.length === 0 && (
    <div class="soon panel" data-reveal>
      <p class="mono">→ primer prompt en camino</p>
    </div>
  )}
</Base>

<style>
  .page-head { padding: 40px 0 10px; }
  .page-head h1 { font-size: clamp(1.9rem, 4vw, 2.3rem); margin: 10px 0 14px; }
  .lede { color: var(--ink-dim); max-width: 55ch; margin: 0; }
  .prompt-list { display: flex; flex-direction: column; gap: 24px; margin: 34px 0 70px; max-width: 780px; }
  .prompt-card { padding: 24px; }
  .prompt-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 14px; flex-wrap: wrap; }
  .prompt-head h2 { font-size: 1.05rem; font-weight: 500; font-family: var(--font-body); }
  pre { white-space: pre-wrap; margin: 0; }
  .soon { max-width: 780px; margin: 34px 0 70px; padding: 40px 32px; text-align: center; }
  .soon p { color: var(--ink-faint); margin: 0; }
</style>
