---
import Base from '../layouts/Base.astro';

const prompts = [
  {
    titulo: 'Calificación de leads por WhatsApp',
    pilar: 'automatizacion',
    texto: `Eres un asistente de recepción para una clínica de [especialidad]. Un paciente escribió por WhatsApp preguntando por una hora. Tu tarea:
1. Saluda de forma breve y cálida.
2. Pregunta el motivo de consulta en una sola pregunta.
3. Pregunta si es primera vez o control.
4. No agendes tú: deriva a un horario disponible que te entregará el sistema.
Responde siempre en español de Chile, en un máximo de 2 líneas por mensaje.`,
  },
  {
    titulo: 'Resumen de ficha clínica para el profesional',
    pilar: 'salud',
    texto: `Resume la siguiente ficha clínica en máximo 5 líneas, priorizando: motivo de consulta actual, antecedentes relevantes, medicación activa y alertas (alergias, condiciones crónicas). No inventes datos que no estén en el texto. Si falta un campo, indícalo como "no registrado".`,
  },
  {
    titulo: 'Recordatorio de cita con reprogramación',
    pilar: 'automatizacion',
    texto: `Redacta un recordatorio de cita por WhatsApp para mañana a las {hora} con {profesional}. Debe incluir una opción clara para confirmar o reprogramar respondiendo el mismo mensaje, en un tono directo y breve, sin firma formal.`,
  },
  {
    titulo: 'Explicación de resultados de examen en lenguaje simple',
    pilar: 'salud',
    texto: `Actúa como asistente de redacción para un profesional de salud. Te entregaré el resultado de un examen de laboratorio con sus valores y rangos de referencia. Reescríbelo en español simple, sin jerga médica, para que un paciente sin formación clínica lo entienda. No emitas diagnósticos ni recomendaciones de tratamiento — solo explica qué mide cada valor y si está dentro o fuera del rango de referencia entregado. Si un valor está fuera de rango, indica que debe conversarlo con su médico tratante.`,
  },
];

const pilarLabel: Record<string, string> = { salud: 'IA en salud', automatizacion: 'Automatización' };
---
<Base title="Prompts" description="Prompts probados en producción para clínicas y automatización con IA.">
  <section class="page-head" data-reveal>
    <span class="eyebrow">// Recorta y usa</span>
    <h1>Prompts</h1>
    <p class="lede">Prompts que usamos en producción, no genéricos de Twitter. Cópialos y ajusta lo que está entre llaves.</p>
  </section>

  <div class="prompt-list">
    {prompts.map((p) => (
      <article class="prompt-card coupon" data-reveal>
        <div class="prompt-head">
          <h2>{p.titulo}</h2>
          <span class="tag" data-pilar={p.pilar}>{pilarLabel[p.pilar]}</span>
        </div>
        <pre><code>{p.texto}</code></pre>
      </article>
    ))}
  </div>
</Base>

<style>
  .page-head { padding: 40px 0 10px; }
  .page-head h1 { font-size: clamp(1.9rem, 4vw, 2.3rem); margin: 10px 0 14px; }
  .lede { color: var(--ink-dim); max-width: 55ch; margin: 0; }
  .prompt-list { display: flex; flex-direction: column; gap: 24px; margin: 34px 0 70px; max-width: 780px; }
  .prompt-card { padding: 24px; }
  .prompt-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 14px; flex-wrap: wrap; }
  .prompt-head h2 { font-size: 1.05rem; font-weight: 500; font-family: var(--font-body); }
  pre { white-space: pre-wrap; margin: 0; }
</style>
