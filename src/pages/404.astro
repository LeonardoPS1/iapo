---
import Base from '../layouts/Base.astro';

const collectionPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': 'https://iapo.cl/404#page',
  name: 'Página no encontrada - iapo.cl',
  url: 'https://iapo.cl/404',
};

const exits = [
  { href: '/', label: 'Portada' },
  { href: '/blog/', label: 'Blog' },
  { href: '/rankings/', label: 'Rankings' },
  { href: '/prompts/', label: 'Prompts' },
];
---
<Base
  title="Página no encontrada"
  description="La página que buscás no existe o cambió de dirección."
  structuredData={[collectionPage]}
  noindex
>
  <section class="page-head" data-reveal>
    <span class="eyebrow">// Error 404</span>
    <h1>Esta página no salió en esta edición</h1>
    <p class="lede">
      El enlace puede estar viejo o mal escrito. Probá desde alguna de estas secciones.
    </p>
  </section>

  <nav class="exits" aria-label="Secciones del sitio" data-reveal>
    {exits.map((e) => (
      <a href={e.href} class="exit">{e.label} ↗</a>
    ))}
  </nav>
</Base>

<style>
  .page-head { padding: 48px 0 10px; }
  .page-head h1 { font-size: clamp(1.9rem, 4vw, 2.3rem); margin: 10px 0 14px; }
  .lede { color: var(--ink-dim); max-width: 55ch; margin: 0; }
  .exits { display: flex; flex-wrap: wrap; gap: 12px; margin: 34px 0 80px; }
  .exit {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border: 1.5px solid var(--rule);
    border-radius: 3px;
    padding: 9px 14px;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .exit:hover { border-color: var(--core); color: var(--core); }
</style>
