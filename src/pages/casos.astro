---
import Base from '../layouts/Base.astro';
---
<Base title="Casos" description="Casos reales de clínicas que automatizaron captación y gestión de pacientes.">
  <section class="page-head" data-reveal>
    <span class="eyebrow">// Casos de estudio</span>
    <h1>Resultados reales, no promesas</h1>
    <p class="lede">
      Estamos documentando los primeros pilotos de automatización de captación y gestión para
      clínicas en Chile. Los primeros casos con datos y testimonios se publican aquí.
    </p>
  </section>
  <div class="soon panel" data-reveal>
    <p class="mono">→ primer caso en camino</p>
  </div>
</Base>

<style>
  .page-head { padding: 40px 0 10px; }
  .page-head h1 { font-size: clamp(1.9rem, 4vw, 2.3rem); margin: 10px 0 14px; }
  .lede { color: var(--ink-dim); max-width: 55ch; margin: 0; }
  .soon { max-width: 780px; margin: 34px 0 80px; padding: 40px 32px; text-align: center; }
  .soon p { color: var(--ink-faint); margin: 0; }
</style>
