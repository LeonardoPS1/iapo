---
interface Props {
  size?: number; // px — controls the whole lockup via em-based children
}
const { size = 28 } = Astro.props;
---
<span class="wordmark" style={`font-size:${size}px`}>
  <span class="wm-ia">
    <svg class="wm-bot" viewBox="0 0 24 24" aria-hidden="true">
      <line x1="12" y1="1" x2="12" y2="6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      <circle class="wm-bot-ball" cx="12" cy="1" r="1.9" fill="var(--comic-red)" />
      <circle cx="12" cy="14" r="8" fill="var(--paper-raised)" stroke="currentColor" stroke-width="1.8" />
      <circle cx="9" cy="13" r="1.7" fill="var(--core)" />
      <circle cx="15" cy="13" r="1.7" fill="var(--comic-red)" />
      <path d="M9 18c1.2 1.1 3.8 1.1 5 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none" />
    </svg>
    <span class="wm-i">i</span>a
  </span><span class="wm-po-wrap"><span class="wm-po">po</span></span><span class="wm-tld mono">.cl</span>
</span>

<style>
  .wordmark {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-nameplate);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .wm-ia {
    position: relative;
    color: var(--ink);
    display: inline-block;
    padding-left: 0.62em;
  }
  .wm-bot {
    position: absolute;
    top: -0.42em;
    left: 0.02em;
    width: 0.48em;
    height: 0.48em;
    color: var(--ink);
  }
  .wm-i {
    position: relative;
  }
  .wm-bot-ball {
    transform-box: fill-box;
    transform-origin: center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .wm-bot-ball { animation: bot-blink 2.6s ease-in-out infinite; }
  }
  @keyframes bot-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .wm-po-wrap {
    display: inline-flex;
    margin-left: 0.16em;
    align-self: center;
  }
  .wm-po {
    position: relative;
    display: inline-block;
    font-size: 0.62em;
    padding: 0.14em 0.34em 0.16em;
    border: 0.09em solid var(--comic-red);
    border-radius: 0.75em 0.85em 0.7em 0.25em / 0.9em 0.7em 0.9em 0.6em;
    background: var(--paper-raised);
    color: var(--comic-red);
    transform: rotate(-5deg);
  }
  .wm-po::before,
  .wm-po::after {
    content: '';
    position: absolute;
    left: 0.22em;
    width: 0;
    height: 0;
    border-style: solid;
  }
  .wm-po::before {
    bottom: -0.34em;
    border-width: 0.2em 0.12em 0 0;
    border-color: var(--comic-red) transparent transparent transparent;
  }
  .wm-po::after {
    bottom: -0.2em;
    left: 0.26em;
    border-width: 0.13em 0.08em 0 0;
    border-color: var(--paper-raised) transparent transparent transparent;
  }
  .wm-tld {
    font-family: var(--font-mono);
    font-size: 0.34em;
    font-weight: 400;
    color: var(--ink-faint);
    align-self: flex-end;
    margin-left: 0.2em;
    margin-bottom: 0.05em;
  }
</style>
