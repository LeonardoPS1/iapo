---
interface Props {
  size?: number; // px — controls the whole lockup via em-based children
}
const { size = 28 } = Astro.props;
---
<span class="wordmark" style={`font-size:${size}px`}>
  <span class="wm-ia">ia</span><span class="wm-po">po</span><span class="wm-tld mono">.cl</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-nameplate);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .wm-ia {
    color: var(--ink);
  }
  .wm-po {
    display: inline-block;
    color: var(--comic-red);
    transform: rotate(-6deg);
    margin-left: 0.03em;
  }
  .wm-tld {
    font-family: var(--font-mono);
    font-size: 0.34em;
    font-weight: 400;
    color: var(--ink-faint);
    align-self: flex-end;
    margin-left: 0.2em;
    margin-bottom: 0.05em;
  }
</style>
