---
interface Props {
  size?: number;
}
const { size = 280 } = Astro.props;
---
<div class="mascot" style={`width:${size}px`}>
  <svg viewBox="0 0 220 260" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <!-- antenna -->
    <line x1="110" y1="18" x2="110" y2="42" stroke="var(--ink)" stroke-width="4" stroke-linecap="round" />
    <circle class="mascot-ball" cx="110" cy="16" r="7" fill="var(--comic-red)" stroke="var(--ink)" stroke-width="3" />

    <!-- head -->
    <circle cx="110" cy="96" r="60" fill="var(--paper-raised)" stroke="var(--ink)" stroke-width="4.5" />
    <circle cx="90" cy="92" r="10" fill="var(--core)" />
    <circle cx="130" cy="92" r="10" fill="var(--comic-red)" />
    <path d="M85 118c9 9 41 9 50 0" stroke="var(--ink)" stroke-width="4.5" stroke-linecap="round" fill="none" />

    <!-- body -->
    <rect x="62" y="152" width="96" height="70" rx="14" fill="var(--paper-raised)" stroke="var(--ink)" stroke-width="4.5" />
    <line x1="80" y1="172" x2="140" y2="172" stroke="var(--ink-faint)" stroke-width="2.5" stroke-linecap="round" />
    <line x1="80" y1="184" x2="128" y2="184" stroke="var(--ink-faint)" stroke-width="2.5" stroke-linecap="round" />
    <line x1="80" y1="196" x2="136" y2="196" stroke="var(--ink-faint)" stroke-width="2.5" stroke-linecap="round" />

    <!-- arm holding the sign -->
    <path d="M158 178c14 2 24 12 26 26" stroke="var(--ink)" stroke-width="4.5" stroke-linecap="round" fill="none" />

    <!-- sign -->
    <g class="mascot-sign">
      <rect x="150" y="60" width="66" height="42" rx="6" fill="var(--paper-raised)" stroke="var(--comic-red)" stroke-width="4" transform="rotate(8 150 60)" />
      <text x="183" y="90" transform="rotate(8 150 60)" text-anchor="middle" class="mascot-sign-text">¡ia po!</text>
    </g>
  </svg>
</div>

<style>
  .mascot {
    max-width: 100%;
    aspect-ratio: 220 / 260;
  }
  .mascot svg { width: 100%; height: 100%; display: block; overflow: visible; }
  .mascot-sign-text {
    font-family: var(--font-marker);
    font-size: 22px;
    font-weight: 700;
    fill: var(--comic-red);
  }
  .mascot-ball, .mascot-sign {
    transform-box: fill-box;
    transform-origin: center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mascot-ball { animation: mascot-blink 2.6s ease-in-out infinite; }
    .mascot-sign { animation: mascot-wobble 3.4s ease-in-out infinite; }
  }
  @keyframes mascot-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }
  @keyframes mascot-wobble {
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(-3deg); }
  }
</style>
