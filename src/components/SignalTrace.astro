---
interface Props {
  height?: number;
  color?: string;
}
const { height = 64, color = 'var(--amber)' } = Astro.props;

// Deterministic pseudo-random oscilloscope-like waveform path.
function buildPath(width: number, h: number, seed: number) {
  const points: string[] = [];
  const steps = 48;
  for (let i = 0; i <= steps; i++) {
    const x = (i / steps) * width;
    const t = i / steps;
    const wobble =
      Math.sin(t * Math.PI * 6 + seed) * 0.35 +
      Math.sin(t * Math.PI * 13 + seed * 2) * 0.18 +
      Math.sin(t * Math.PI * 2.3) * 0.3;
    const y = h / 2 + wobble * (h / 2 - 4);
    points.push(`${x.toFixed(1)},${y.toFixed(1)}`);
  }
  return `M${points.join(' L')}`;
}

const width = 1000;
const path = buildPath(width, height, 1.3);
---
<svg
  class="signal-trace"
  viewBox={`0 0 ${width} ${height}`}
  preserveAspectRatio="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <path d={path} fill="none" stroke={color} stroke-width="1.5" stroke-linecap="round" />
</svg>

<style define:vars={{ traceColor: color }}>
  .signal-trace {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .signal-trace path {
    stroke-dasharray: 2200;
    stroke-dashoffset: 2200;
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--traceColor) 55%, transparent));
    animation: draw-trace 2.6s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }
  @media (prefers-reduced-motion: reduce) {
    .signal-trace path {
      stroke-dashoffset: 0;
      animation: none;
    }
  }
  @keyframes draw-trace {
    to { stroke-dashoffset: 0; }
  }
</style>
