---
interface Props {
  kind: 'repos' | 'skills' | 'mcp';
}

const { kind } = Astro.props;

const KINDS = {
  repos: { label: '// REPOS', color: 'var(--core)' },
  skills: { label: '// SKILLS', color: 'var(--comic-red)' },
  mcp: { label: '// MCP', color: 'var(--ia-general)' },
} as const;

const k = KINDS[kind];
---

<span class="rank-stamp" data-reveal data-stamp style={`--stamp-color:${k.color}`} aria-hidden="true">{k.label}</span>

<style>
  .rank-stamp {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--stamp-color);
    border: 1.5px dashed var(--stamp-color);
    border-radius: 4px;
    padding: 6px 11px 5px;
    background: color-mix(in srgb, var(--stamp-color) 6%, var(--paper-raised));
    box-shadow: 0 4px 14px color-mix(in srgb, var(--stamp-color) 18%, transparent);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }
</style>