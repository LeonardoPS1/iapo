---
import Stamp from './Stamp.astro';
import CountMetric from './CountMetric.astro';

interface Item {
  rank: number;
  name: string;
  url: string;
  metricNumber: number;
  metricDisplay: string;
  language?: string;
  origin?: string;
  description: string;
  why: string;
}

interface Props {
  kind: 'repos' | 'skills' | 'mcp';
  label: string;
  window: string;
  source: string;
  items: Item[];
}

const { kind, label, window, source, items } = Astro.props;

const KIND_NUM = { repos: '01', skills: '02', mcp: '03' } as const;
const KIND_COLOR = {
  repos: 'var(--core)',
  skills: 'var(--comic-red)',
  mcp: 'var(--ia-general)',
} as const;
const KIND_SHORT = { repos: 'REPOS', skills: 'SKILLS', mcp: 'MCP' } as const;

const max = items[0]?.metricNumber || 1;
const pct = (n: number) => Math.max(6, Math.round((n / max) * 100));
const kindColor = KIND_COLOR[kind];
---

<section class="score" id={kind} data-reveal style={`--kind:${kindColor}`}>
  <header class="score-head">
    <span class="score-folio mono" aria-hidden="true">{KIND_NUM[kind]}</span>
    <div class="score-head-main">
      <span class="eyebrow score-kicker">// {KIND_SHORT[kind]}</span>
      <h2 class="score-title">{label}</h2>
      <div class="score-head-meta">
        <span class="score-window mono"><span class="live-dot" aria-hidden="true"></span>{window}</span>
        <a class="score-source mono" href={source} rel="noopener">Ver fuente ↗</a>
      </div>
    </div>
    <div class="score-stamps"><Stamp kind={kind} /></div>
  </header>

  <ol class="score-list">
    {items.map((item) => (
      <li class="score-row panel" data-reveal data-rank={item.rank} style={`--bar:${pct(item.metricNumber)}%`}>
        <span class="score-rank mono" aria-hidden="true">{String(item.rank).padStart(2, '0')}</span>
        <div class="score-body">
          <div class="score-topline">
            <a class="score-name" href={item.url}>{item.name}</a>
            <div class="score-meta mono">
              {item.language && <span class="chip score-lang">{item.language}</span>}
              {item.origin && <span class="chip chip-origin">@{item.origin}</span>}
            </div>
          </div>
          <div class="score-metric"><CountMetric number={item.metricNumber} display={item.metricDisplay} /></div>
          <span class="score-bar" aria-hidden="true"><span class="score-bar-fill"></span></span>
          <p class="score-desc">{item.description}</p>
          {item.why && <p class="score-why"><strong>Por qué importa:</strong> {item.why}</p>}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .score {
    position: relative;
    padding: 12px 0 8px;
    scroll-margin-top: 84px;
  }

  /* ===== Cabecera de sección — tipo página foliada ===== */
  .score-head {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2px 22px;
    padding: 22px 24px 20px;
    margin-bottom: 22px;
    background: color-mix(in srgb, var(--kind) 7%, var(--paper-raised));
    border: 1px solid var(--rule);
    border-top: 3px solid var(--kind);
    border-radius: 12px;
    overflow: hidden;
  }
  .score-head::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 88% 18%, color-mix(in srgb, var(--kind) 16%, transparent) 0 34px, transparent 35px),
      radial-gradient(circle at 0% 100%, var(--ink) 0 1px, transparent 1.5px);
    background-size: auto, 22px 22px;
    opacity: 0.5;
  }

  .score-folio {
    grid-row: 1 / span 2;
    align-self: center;
    z-index: 1;
    font-size: 4.2rem;
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.03em;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--kind) 42%, transparent);
    user-select: none;
  }

  .score-head-main { z-index: 1; }
  .score-kicker { color: var(--kind); font-weight: 800; letter-spacing: 0.14em; }
  .score-title {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.05;
    margin: 3px 0 10px;
  }
  .score-head-meta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }

  .score-window {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11.5px;
    color: var(--ink-dim);
    padding: 4px 11px;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 999px;
    white-space: nowrap;
  }
  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--kind);
    animation: live-pulse 2s var(--ease-in-out) infinite;
  }
  @keyframes live-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.8); }
  }

  .score-source { font-size: 11px; color: var(--kind); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .score-source:hover { text-decoration-color: color-mix(in srgb, var(--kind) 40%, transparent); }

  .score-stamps { position: absolute; top: 14px; right: 16px; z-index: 1; }

  /* ===== Lista de filas ===== */
  .score-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }

  .score-row {
    display: grid;
    grid-template-columns: 58px 1fr;
    gap: 10px 20px;
    align-items: start;
    padding: 20px 22px;
    border-left: 4px solid transparent;
    transition:
      transform var(--dur-slow) var(--ease-out),
      box-shadow var(--dur-slow) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .score-row:hover {
      transform: translateX(4px);
      border-left-color: var(--kind);
      box-shadow: 0 16px 32px color-mix(in srgb, var(--kind) 12%, transparent);
    }
  }
  .score-row:focus-within {
    border-left-color: var(--kind);
    box-shadow: 0 16px 32px color-mix(in srgb, var(--kind) 12%, transparent);
  }

  /* Medallones de ranking */
  .score-rank {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 1rem;
    font-weight: 800;
    color: var(--ink-dim);
    background: var(--paper-raised);
    border: 2px solid var(--rule);
    transition: all var(--dur-slow) var(--ease-out);
  }
  .score-row[data-rank="1"] .score-rank {
    background: var(--kind);
    border-color: var(--kind);
    color: var(--paper-raised);
    box-shadow: 0 6px 16px color-mix(in srgb, var(--kind) 40%, transparent);
  }
  .score-row[data-rank="2"] .score-rank { border-color: var(--kind); color: var(--kind); }
  .score-row[data-rank="3"] .score-rank { border-color: var(--comic-red); color: var(--comic-red); }

  .score-body { display: grid; grid-template-columns: 1fr auto; gap: 4px 16px; }
  .score-topline { grid-column: 1; display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }

  .score-name { font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; color: var(--ink); }
  a.score-name:hover { color: var(--kind); }
  a.score-name:focus-visible { outline: 2px solid var(--kind); outline-offset: 2px; border-radius: 2px; }

  .score-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .chip {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--kind);
    background: color-mix(in srgb, var(--kind) 10%, var(--paper-raised));
    border: 1px solid color-mix(in srgb, var(--kind) 25%, transparent);
    border-radius: 999px;
    padding: 3px 9px;
  }
  .chip-origin { color: var(--ink-dim); background: var(--paper-raised); border-color: var(--rule); }

  .score-metric {
    grid-column: 2;
    grid-row: 1;
    align-self: start;
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--kind);
    white-space: nowrap;
  }
  .score-row[data-rank="1"] .score-metric { font-size: 1.65rem; color: var(--kind); }
  .score-row:not([data-rank="1"]) .score-metric { color: var(--ink); }

  /* Barra de tracción — tinta que sube */
  .score-bar {
    grid-column: 1 / -1;
    display: block;
    height: 10px;
    background: var(--rule);
    border-radius: 999px;
    overflow: hidden;
  }
  .score-bar-fill {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--kind) 72%, var(--ink)),
      var(--kind) 45%,
      color-mix(in srgb, var(--kind) 65%, var(--core-bright))
    );
    background-size: 200% 100%;
    animation: bar-shimmer 2.6s var(--ease-in-out) infinite alternate;
    box-shadow: 0 0 14px color-mix(in srgb, var(--kind) 45%, transparent);
    transition: width 1s var(--ease-out);
  }
  .score-row.is-visible .score-bar-fill { width: var(--bar); }
  @keyframes bar-shimmer {
    from { background-position: 0% 0; }
    to { background-position: 100% 0; }
  }

  .score-desc { grid-column: 1 / -1; color: var(--ink-dim); font-size: 0.95rem; line-height: 1.6; margin: 6px 0 0; }
  .score-why { grid-column: 1 / -1; color: var(--ink-dim); font-size: 0.95rem; line-height: 1.6; margin: 2px 0 0; font-style: italic; }
  .score-why strong { color: var(--comic-red); font-style: normal; font-weight: 700; }

  @media (prefers-reduced-motion: reduce) {
    .live-dot { animation: none; }
    .score-bar-fill { width: var(--bar) !important; animation: none; transition: none; box-shadow: none; }
    .score-row, .score-rank, .score-metric { transition: none; }
  }

  @media (max-width: 620px) {
    .score-head { grid-template-columns: 1fr; gap: 8px; }
    .score-folio { grid-row: auto; font-size: 2.6rem; }
    .score-title { font-size: 1.55rem; }
    .score-window { white-space: normal; }
    .score-row { grid-template-columns: 48px 1fr; padding: 16px 16px; }
    .score-body { grid-template-columns: 1fr; }
    .score-metric { grid-column: 1; grid-row: auto; margin-bottom: 6px; font-size: 1.1rem; }
    .score-row[data-rank="1"] .score-metric { font-size: 1.35rem; }
    .score-stamps { top: 10px; right: 10px; }
  }
  @media (max-width: 420px) {
    .score-name { font-size: 1.1rem; }
  }
</style>