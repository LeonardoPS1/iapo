---
// HeroArt - Animated SVG illustration for homepage
// Represents AI + human collaboration (robot + tablet)
---

<style>
  .hero-art {
    width: 100%;
    max-width: 380px;
    height: auto;
    opacity: 0;
    transform: translateY(20px) scale(0.98);
    transition: opacity 600ms var(--ease-out), transform 600ms var(--ease-out);
    transition-delay: 480ms;
  }
  .is-revealed .hero-art {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  /* Floating animation for robot */
  @media (prefers-reduced-motion: no-preference) {
    .hero-art__robot {
      animation: float 4s ease-in-out infinite;
    }
    .hero-art__tablet {
      animation: float 4s ease-in-out infinite reverse;
    }
    .hero-art__sparkle {
      animation: sparkle 2s ease-in-out infinite;
    }
    .hero-art__sparkle:nth-child(2) { animation-delay: 0.5s; }
    .hero-art__sparkle:nth-child(3) { animation-delay: 1s; }
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @keyframes sparkle {
    0%, 100% { opacity: 0.3; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.2); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-art { transition-duration: 0ms; opacity: 1; transform: none; }
    .hero-art__robot, .hero-art__tablet, .hero-art__sparkle { animation: none; }
  }
</style>

<div class="hero-art" aria-hidden="true">
  <svg viewBox="0 0 380 280" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Background grid subtle -->
    <defs>
      <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
        <path d="M 20 0 L 0 0 0 20" fill="none" stroke="var(--ink-faint)" stroke-width="0.5" opacity="0.15"/>
      </pattern>
    </defs>
    <rect width="380" height="280" fill="url(#grid)"/>

    <!-- Tablet held by human hand -->
    <g class="hero-art__tablet" transform="translate(60, 40)">
      <!-- Tablet body -->
      <rect x="0" y="0" width="140" height="180" rx="12" fill="var(--paper-raised)" stroke="var(--ink)" stroke-width="2"/>
      <rect x="8" y="8" width="124" height="164" rx="8" fill="var(--ink)" />
      <!-- Screen content: code lines -->
      <g fill="var(--core-bright)">
        <rect x="18" y="20" width="60" height="3" rx="1.5"/>
        <rect x="18" y="30" width="80" height="3" rx="1.5"/>
        <rect x="18" y="40" width="45" height="3" rx="1.5"/>
        <rect x="18" y="55" width="90" height="3" rx="1.5"/>
        <rect x="18" y="65" width="55" height="3" rx="1.5"/>
        <rect x="18" y="80" width="100" height="3" rx="1.5"/>
        <rect x="18" y="90" width="70" height="3" rx="1.5"/>
      </g>
      <!-- Home indicator -->
      <rect x="60" y="168" width="20" height="3" rx="1.5" fill="var(--ink-faint)" opacity="0.5"/>
    </g>

    <!-- Human hand holding tablet (simplified) -->
    <path d="M 55 180 Q 45 185 40 170 Q 30 150 35 130 Q 45 120 55 125 Q 65 130 70 145 Q 78 165 70 185 Q 55 200 55 180" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5"/>

    <!-- Robot character -->
    <g class="hero-art__robot" transform="translate(220, 60)">
      <!-- Head -->
      <rect x="0" y="0" width="80" height="80" rx="16" fill="var(--paper-raised)" stroke="var(--ink)" stroke-width="2"/>
      <!-- Eyes -->
      <circle cx="22" cy="30" r="8" fill="var(--ink)"/>
      <circle cx="58" cy="30" r="8" fill="var(--ink)"/>
      <!-- Pupils (animated look) -->
      <circle cx="24" cy="30" r="3" fill="var(--core-bright)"/>
      <circle cx="60" cy="30" r="3" fill="var(--core-bright)"/>
      <!-- Antenna -->
      <path d="M 40 0 L 40 -18" stroke="var(--ink)" stroke-width="2" stroke-linecap="round"/>
      <circle cx="40" cy="-18" r="3" fill="var(--comic-red)"/>
      <!-- Mouth -->
      <path d="M 25 55 Q 40 62 55 55" stroke="var(--ink)" stroke-width="2" fill="none" stroke-linecap="round"/>

      <!-- Body -->
      <rect x="10" y="85" width="60" height="90" rx="12" fill="var(--paper-raised)" stroke="var(--ink)" stroke-width="2"/>
      <!-- Chest display -->
      <rect x="20" y="100" width="40" height="30" rx="4" fill="var(--ink)"/>
      <text x="40" y="122" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--core-bright)" font-weight="700">IA</text>

      <!-- Arms -->
      <path d="M 0 100 Q -20 120 -15 145" stroke="var(--ink)" stroke-width="8" stroke-linecap="round" fill="none"/>
      <path d="M 80 100 Q 100 120 95 145" stroke="var(--ink)" stroke-width="8" stroke-linecap="round" fill="none"/>
      <!-- Hands -->
      <circle cx="-15" cy="145" r="10" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5"/>
      <circle cx="95" cy="145" r="10" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5"/>

      <!-- Legs -->
      <path d="M 22 175 L 22 210" stroke="var(--ink)" stroke-width="8" stroke-linecap="round"/>
      <path d="M 58 175 L 58 210" stroke="var(--ink)" stroke-width="8" stroke-linecap="round"/>
      <ellipse cx="22" cy="212" rx="12" ry="6" fill="var(--ink)"/>
      <ellipse cx="58" cy="212" rx="12" ry="6" fill="var(--ink)"/>
    </g>

    <!-- Sparkles / magic particles -->
    <g fill="var(--comic-red)">
      <circle class="hero-art__sparkle" cx="180" cy="80" r="3"/>
      <circle class="hero-art__sparkle" cx="340" cy="120" r="2"/>
      <circle class="hero-art__sparkle" cx="120" cy="200" r="2.5"/>
      <circle class="hero-art__sparkle" cx="300" cy="220" r="2"/>
    </g>

    <!-- Connection line between robot and tablet (subtle) -->
    <path d="M 160 120 Q 190 110 220 100" stroke="var(--core)" stroke-width="1.5" stroke-dasharray="6 4" opacity="0.3" fill="none"/>
  </svg>
</div>