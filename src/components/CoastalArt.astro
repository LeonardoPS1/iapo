---
// Static, deterministic layered-hills illustration. No randomness so the
// build output is stable.
---
<div class="coastal-art">
  <svg viewBox="0 0 480 400" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#f4ece0" />
        <stop offset="55%" stop-color="#f2ddc4" />
        <stop offset="100%" stop-color="#eecf9f" />
      </linearGradient>
      <radialGradient id="sun" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#f0a24a" stop-opacity="0.95" />
        <stop offset="100%" stop-color="#f0a24a" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="sea" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#0e8a76" stop-opacity="0.35" />
        <stop offset="100%" stop-color="#0e8a76" stop-opacity="0.55" />
      </linearGradient>
    </defs>

    <rect x="0" y="0" width="480" height="400" fill="url(#sky)" />
    <circle class="sun-glow" cx="240" cy="205" r="95" fill="url(#sun)" />
    <circle cx="240" cy="205" r="34" fill="#f7f1e6" stroke="#e6432a" stroke-width="2" opacity="0.92" />

    <!-- sea band -->
    <rect x="0" y="230" width="480" height="170" fill="url(#sea)" />
    <line x1="0" y1="230" x2="480" y2="230" stroke="#15171c" stroke-width="1" opacity="0.15" />

    <!-- layered cliffs, back to front -->
    <path d="M0,260 L0,210 C60,195 120,225 190,205 C260,185 300,215 360,195 C410,180 460,200 480,190 L480,260 Z" fill="#15171c" opacity="0.14" />
    <path d="M0,290 L0,240 C70,255 130,215 210,235 C280,252 330,218 400,232 C440,240 465,225 480,222 L480,290 Z" fill="#15171c" opacity="0.22" />
    <path d="M0,330 L0,268 C80,290 150,250 230,270 C300,287 350,255 420,268 C450,274 470,262 480,258 L480,330 Z" fill="#15171c" opacity="0.85" />

    <!-- boat, small deliberate detail -->
    <g class="boat" opacity="0.7">
      <path d="M330,318 l38,0 l-6,10 l-26,0 Z" fill="#15171c" />
      <line x1="349" y1="318" x2="349" y2="300" stroke="#15171c" stroke-width="1.5" />
      <path d="M349,301 l14,10 l-14,4 Z" fill="#e6432a" />
    </g>
  </svg>
</div>

<style>
  .coastal-art {
    width: 100%;
    aspect-ratio: 480 / 400;
    border-radius: 6px;
    overflow: hidden;
    border: 1.5px solid var(--ink);
  }
  .coastal-art svg { width: 100%; height: 100%; display: block; }
  .sun-glow {
    transform-box: fill-box;
    transform-origin: center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .sun-glow { animation: sun-breathe 6s ease-in-out infinite; }
  }
  @keyframes sun-breathe {
    0%, 100% { opacity: 0.85; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.06); }
  }
</style>
