---
interface Props {
  size?: number;
}
const { size = 96 } = Astro.props;
const pathId = `seal-circle-${Math.random().toString(36).slice(2, 8)}`;
---
<div class="seal-badge" style={`width:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
    <!-- anillos -->
    <circle cx="60" cy="60" r="56" fill="none" stroke="var(--ink)" stroke-width="2.5" />
    <circle cx="60" cy="60" r="46" fill="none" stroke="var(--ink)" stroke-width="1.5" stroke-dasharray="2 3" opacity="0.6" />

    <!-- texto en la circunferencia -->
    <path id={pathId} d="M60,60 m-51,0 a51,51 0 1,1 102,0 a51,51 0 1,1 -102,0" fill="none" />
    <text class="seal-text">
      <textPath href={`#${pathId}`} startOffset="0%" text-anchor="middle">
        IAPO · N°1 · VIÑA DEL MAR · 2026 ·
      </textPath>
    </text>

    <!-- señal central -->
    <g class="seal-core">
      <circle cx="60" cy="60" r="4.5" fill="var(--comic-red)" />
      <path d="M60,60 m-12,0 a12,12 0 0,0 24,0" fill="none" stroke="var(--core)" stroke-width="3.5" stroke-linecap="round" />
      <path d="M60,60 m-21,0 a21,21 0 0,0 42,0" fill="none" stroke="var(--ink)" stroke-width="3" stroke-linecap="round" opacity="0.5" />
    </g>
  </svg>
</div>

<style>
  .seal-badge {
    max-width: 100%;
    aspect-ratio: 1;
    flex-shrink: 0;
  }
  .seal-badge svg { width: 100%; height: 100%; display: block; overflow: visible; }
  .seal-text {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    fill: var(--ink);
    text-transform: uppercase;
  }
  @media (prefers-reduced-motion: no-preference) {
    .seal-badge { animation: seal-float 5.5s ease-in-out infinite; }
    .seal-core {
      transform-box: fill-box;
      transform-origin: center;
      animation: seal-pulse 3s ease-in-out infinite;
    }
  }
  @keyframes seal-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }
  @keyframes seal-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
  }
</style>
