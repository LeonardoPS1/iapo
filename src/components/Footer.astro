---
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-left">
      <span class="status-pill"><span class="status-dot"></span>EN VIVO · VIÑA DEL MAR, CL</span>
      <p class="mono coords">-33.0153° S · -71.5500° W</p>
    </div>
    <p class="mono credit">© {year} · un proyecto de <a href="https://aicorebots.com">Aicore Agency</a></p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 32px 0 60px;
    margin-top: 60px;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 16px;
  }
  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .coords {
    font-size: 11px;
    color: var(--text-faint);
    margin: 0;
  }
  .credit {
    font-size: 12.5px;
    color: var(--text-dim);
    margin: 0;
  }
</style>
