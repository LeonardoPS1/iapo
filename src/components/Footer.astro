---
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-left">
      <span class="status-pill"><span class="status-dot"></span>EN VIVO · VIÑA DEL MAR, CL</span>
      <p class="mono coords">-33.0153° S · -71.5500° W</p>
    </div>
    <div class="footer-right">
      <p class="mono credit">© {year} · un proyecto de <a href="https://aicorebots.com">Aicore Agency</a></p>
      <nav class="footer-legal" aria-label="Legal">
        <a href="/aviso-legal">Aviso legal</a>
        <span class="legal-sep">·</span>
        <a href="/privacidad">Privacidad</a>
        <span class="legal-sep">·</span>
        <a href="/terminos">Términos</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 2.5px solid var(--ink);
    padding: 32px 0 60px;
    margin-top: 60px;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 16px;
  }
  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .footer-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }
  .coords {
    font-size: 11px;
    color: var(--ink-faint);
    margin: 0;
  }
  .credit {
    font-size: 12.5px;
    color: var(--ink-dim);
    margin: 0;
  }
  .footer-legal {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11.5px;
  }
  .footer-legal a {
    color: var(--ink-dim);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .footer-legal a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .legal-sep {
    color: var(--ink-faint);
  }
</style>
