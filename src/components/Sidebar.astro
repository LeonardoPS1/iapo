---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  currentId?: string;
}
const { posts, currentId } = Astro.props;

const dateFmt = (d: Date) => new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'short' }).format(d);
const list = posts.filter((p) => p.id !== currentId).slice(0, 5);
---
<aside class="sidebar" data-reveal>
  <div class="sidebar-head">
    <span class="eyebrow">// Últimas</span>
  </div>
  <ol class="sidebar-list">
    {list.map((post, i) => (
      <li>
        <a href={`/blog/${post.id}`} class="sidebar-item">
          <span class="sidebar-num mono">{String(i + 1).padStart(2, '0')}</span>
          <span class="sidebar-body">
            <span class="sidebar-title">{post.data.title}</span>
            <span class="sidebar-date mono">{dateFmt(post.data.pubDate)}</span>
          </span>
        </a>
      </li>
    ))}
  </ol>

  <div class="sidebar-box coupon">
    <p class="mono sidebar-box-eyebrow">// Frecuencia semanal</p>
    <p class="sidebar-box-text">3 tips, 1 repo, 1 caso real. Cada semana.</p>
    <form class="sidebar-form" action="https://newsletter.iapo.cl/subscription/form" method="post">
      <input type="email" name="email" placeholder="tu@correo.cl" required aria-label="Correo electrónico" />
      <button type="submit">Suscribirme</button>
    </form>
  </div>
</aside>

<style>
  .sidebar { display: flex; flex-direction: column; gap: 32px; }
  .sidebar-head { margin-bottom: 4px; }
  .sidebar-list { list-style: none; margin: 0; padding: 0; }
  .sidebar-item {
    display: flex;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
  }
  .sidebar-item:hover { text-decoration: none; }
  .sidebar-item:hover .sidebar-title { color: var(--core); }
  .sidebar-num {
    font-size: 12px;
    color: var(--comic-red);
    font-weight: 700;
    flex-shrink: 0;
    padding-top: 1px;
  }
  .sidebar-body { display: flex; flex-direction: column; gap: 5px; }
  .sidebar-title { font-size: 0.92rem; line-height: 1.35; font-weight: 500; transition: color 0.15s ease; }
  .sidebar-date { font-size: 10.5px; color: var(--ink-faint); letter-spacing: 0.04em; }

  .sidebar-box { padding: 20px; }
  .sidebar-box-eyebrow { font-size: 11px; letter-spacing: 0.1em; color: var(--ink-faint); margin: 0 0 8px; text-transform: uppercase; }
  .sidebar-box-text { font-size: 0.92rem; color: var(--ink-dim); margin: 0 0 14px; line-height: 1.5; }
  .sidebar-form { display: flex; flex-direction: column; gap: 8px; }
  .sidebar-form input {
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    padding: 9px 11px;
    font-family: var(--font-body);
    font-size: 0.9rem;
  }
  .sidebar-form button {
    font-family: var(--font-mono);
    font-weight: 700;
    background: var(--core);
    color: var(--paper-raised);
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    padding: 10px;
    cursor: pointer;
    transition: filter 0.15s ease;
  }
  .sidebar-form button:hover { filter: brightness(1.1); }
</style>
