---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  currentId?: string;
}
const { posts, currentId } = Astro.props;

const allPosts = posts.sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));

const pilarLabel = {
  salud: 'IA en salud',
  automatizacion: 'Automatización',
  'ia-general': 'IA general',
};

const postsByPilar = allPosts.reduce((acc, post) => {
  const pilar = post.data.pilar;
  if (!acc[pilar]) acc[pilar] = [];
  acc[pilar].push(post);
  return acc;
}, {});

const currentPilar = allPosts.find((p) => p.id === currentId)?.data.pilar;
const dateFmt = (d: Date) => new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);
---
<aside class="sidebar" data-reveal>
  <div class="sidebar-head">
    <span class="eyebrow">// Archivo</span>
    <h3>Por tema</h3>
  </div>
  <ul class="sidebar-list">
    {Object.entries(postsByPilar).map(([pilar, pilarPosts]) => (
      <li class="sidebar-pilar-group {pilar === currentPilar ? 'active' : ''}">
        <span class="sidebar-pilar-label" data-pilar={pilar}>{pilarLabel[pilar]}</span>
        <ul class="sidebar-pilar-posts">
          {pilarPosts.map((post, index) => (
            <li class="sidebar-item">
              <a href={`/blog/${post.id}`} class={post.id === currentId ? 'active' : ''}>
                <span class="sidebar-num">{index + 1}</span>
                <span class="sidebar-body">
                  <span class="sidebar-title">{post.data.title}</span>
                  <span class="sidebar-date">{dateFmt(post.data.pubDate)}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</aside>

<style>
  .sidebar { display: flex; flex-direction: column; gap: 32px; }
  .sidebar-head { margin-bottom: 4px; }
  .sidebar-head h3 { font-size: 1rem; font-weight: 500; margin: 0; }
  .sidebar-list { list-style: none; margin: 0; padding: 0; }
  .sidebar-pilar-group { margin-bottom: 24px; }
  .sidebar-pilar-group.active .sidebar-pilar-label { color: var(--core); }
  .sidebar-pilar-label { display: block; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--core); font-family: var(--font-mono); margin-bottom: 8px; padding-left: 2px; }
  .sidebar-pilar-posts { list-style: none; margin: 0; padding: 0; }
  .sidebar-item { border-bottom: 1px solid var(--rule); }
  .sidebar-item:last-child { border-bottom: none; }
  .sidebar-item a { display: flex; align-items: flex-start; gap: 12px; padding: 14px 0; color: var(--ink); text-decoration: none; transition: color 0.15s; }
  .sidebar-item a:hover { color: var(--core); text-decoration: none; }
  .sidebar-item a.active { color: var(--core); }
  .sidebar-item a.active .sidebar-title { color: var(--core); }
  .sidebar-num { color: var(--comic-red); flex-shrink: 0; padding-top: 1px; font-size: 12px; font-weight: 700; min-width: 24px; }
  .sidebar-body { flex-direction: column; gap: 5px; display: flex; }
  .sidebar-title { font-size: 0.92rem; font-weight: 500; line-height: 1.35; transition: color 0.15s; }
  .sidebar-date { color: var(--ink-faint); letter-spacing: 0.04em; font-size: 10.5px; }
</style>