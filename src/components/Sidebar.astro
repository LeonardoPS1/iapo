---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  currentId?: string;
}
const { posts, currentId } = Astro.props;

const dateFmt = (d: Date) => new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'short' }).format(d);
const list = posts.filter((p) => p.id !== currentId).slice(0, 5);
---
<aside class="sidebar" data-reveal>
  <div class="sidebar-head">
    <span class="eyebrow">// Últimas</span>
  </div>
  <ol class="sidebar-list">
    {list.map((post, i) => (
      <li>
        <a href={`/blog/${post.id}`} class="sidebar-item">
          <span class="sidebar-num mono">{String(i + 1).padStart(2, '0')}</span>
          <span class="sidebar-body">
            <span class="sidebar-title">{post.data.title}</span>
            <span class="sidebar-date mono">{dateFmt(post.data.pubDate)}</span>
          </span>
        </a>
      </li>
    ))}
  </ol>
</aside>

<style>
  .sidebar { display: flex; flex-direction: column; gap: 32px; }
  .sidebar-head { margin-bottom: 4px; }
  .sidebar-list { list-style: none; margin: 0; padding: 0; }
  .sidebar-item {
    display: flex;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
  }
  .sidebar-item:hover { text-decoration: none; }
  .sidebar-item:hover .sidebar-title { color: var(--core); }
  .sidebar-num {
    font-size: 12px;
    color: var(--comic-red);
    font-weight: 700;
    flex-shrink: 0;
    padding-top: 1px;
  }
  .sidebar-body { display: flex; flex-direction: column; gap: 5px; }
  .sidebar-title { font-size: 0.92rem; line-height: 1.35; font-weight: 500; transition: color 0.15s ease; }
  .sidebar-date { font-size: 10.5px; color: var(--ink-faint); letter-spacing: 0.04em; }
</style>
