---
import PulseLine from './PulseLine.astro';

const nav = [
  { href: '/blog', label: 'Blog' },
  { href: '/prompts', label: 'Prompts' },
  { href: '/repos', label: 'Repos' },
  { href: '/casos', label: 'Casos' },
  { href: '/sobre', label: 'Sobre' },
];
---
<header class="header">
  <div class="wrap header-inner">
    <a href="/" class="logo">
      <span class="logo-mark"><PulseLine height={20} cycles={1} color="var(--core)" /></span>
      iapo<span class="tld">.cl</span>
    </a>
    <nav class="nav">
      {nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--border);
    padding: 22px 0;
    position: relative;
    z-index: 10;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }
  .logo {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 18px;
    color: var(--text);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .logo:hover { text-decoration: none; }
  .tld { color: var(--text-faint); font-weight: 400; }
  .logo-mark {
    width: 30px;
    display: inline-block;
  }
  .nav {
    display: flex;
    gap: 26px;
    font-family: var(--font-mono);
    font-size: 13.5px;
  }
  .nav a {
    color: var(--text-dim);
    position: relative;
    padding-bottom: 3px;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 1px;
    background: var(--core);
    transition: width 0.25s ease;
  }
  .nav a:hover {
    color: var(--text);
    text-decoration: none;
  }
  .nav a:hover::after { width: 100%; }
</style>
