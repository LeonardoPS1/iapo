---
const nav = [
  { href: '/blog', label: 'Blog' },
  { href: '/prompts', label: 'Prompts' },
  { href: '/repos', label: 'Repos' },
  { href: '/casos', label: 'Casos' },
  { href: '/sobre', label: 'Sobre' },
];
---
<header class="header">
  <div class="wrap header-inner">
    <a href="/" class="logo">
      <span class="dot-wrap">
        <span class="dot"></span>
        <span class="dot ping"></span>
      </span>
      iapo<span class="tld">.cl</span>
    </a>
    <nav class="nav">
      {nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--border);
    padding: 20px 0;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .logo {
    font-family: var(--font-mono);
    font-size: 18px;
    color: var(--text);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .logo:hover { text-decoration: none; }
  .tld { color: var(--text-dim); }
  .dot-wrap {
    position: relative;
    width: 8px;
    height: 8px;
    display: inline-block;
  }
  .dot {
    position: absolute;
    inset: 0;
    background: var(--accent);
    border-radius: 50%;
  }
  .dot.ping { background: transparent; border: 1px solid var(--accent); }
  .nav {
    display: flex;
    gap: 20px;
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .nav a { color: var(--text-dim); }
  .nav a:hover { color: var(--text); text-decoration: none; }
</style>
