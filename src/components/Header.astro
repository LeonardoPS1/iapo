---
import Wordmark from './Wordmark.astro';

const nav = [
  { href: '/blog', label: 'Blog' },
  { href: '/prompts', label: 'Prompts' },
  { href: '/repos', label: 'Repos' },
  { href: '/casos', label: 'Casos' },
  { href: '/sobre', label: 'Sobre' },
];
---
<header class="masthead">
  <div class="wrap utility-bar">
    <span class="mono util-item">EDICIÓN N°1 · AGO 2026</span>
    <span class="mono util-item util-locale">VIÑA DEL MAR, CHILE</span>
  </div>
  <div class="wrap nameplate-row">
    <a href="/" class="wordmark-link" aria-label="iapo.cl — inicio">
      <Wordmark size={30} />
    </a>
    <nav class="nav">
      {nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .masthead {
    background: var(--paper-raised);
    border-bottom: 2.5px solid var(--ink);
  }
  .utility-bar {
    display: flex;
    justify-content: space-between;
    padding: 8px 28px;
    border-bottom: 1px solid var(--rule);
  }
  .util-item {
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }
  .util-locale { color: var(--core); font-weight: 700; }

  .nameplate-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 16px 28px;
    flex-wrap: wrap;
  }
  .wordmark-link { text-decoration: none; }
  .wordmark-link:hover { text-decoration: none; }

  .nav {
    display: flex;
    gap: 24px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
  }
  .nav a {
    color: var(--ink);
    position: relative;
    padding-bottom: 3px;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background: var(--comic-red);
    transition: width 0.2s ease;
  }
  .nav a:hover {
    text-decoration: none;
  }
  .nav a:hover::after { width: 100%; }

  @media (max-width: 560px) {
    .utility-bar { flex-direction: column; gap: 4px; padding: 8px 20px; }
    .nameplate-row { padding: 14px 20px; }
    .nav { gap: 16px; font-size: 12px; }
  }
</style>
