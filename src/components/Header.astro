---
import Wordmark from './Wordmark.astro';

const nav = [
  { href: '/blog', label: 'Blog' },
  { href: '/prompts', label: 'Prompts' },
  { href: '/repos', label: 'Repos' },
  { href: '/casos', label: 'Casos' },
  { href: '/sobre', label: 'Sobre' },
];
---
<header class="masthead">
  <div class="wrap utility-bar">
    <span class="mono util-item">EDICIÓN N°1 · AGO 2026</span>
    <span class="mono util-item util-locale">VIÑA DEL MAR, CHILE</span>
  </div>
  <div class="wrap nameplate-row">
    <a href="/" class="wordmark-link" aria-label="iapo.cl — inicio">
      <Wordmark size={38} />
    </a>
  </div>
  <div class="tear-line nav-divider"></div>
  <nav class="wrap nav">
    {nav.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
  </nav>
</header>

<style>
  .masthead {
    background: var(--paper-raised);
    border-bottom: 1.5px solid var(--ink);
  }
  .utility-bar {
    display: flex;
    justify-content: space-between;
    padding: 10px 28px;
  }
  .util-item {
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }
  .util-locale { color: var(--core); font-weight: 700; }

  .nameplate-row {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 28px 18px;
  }
  .wordmark-link { text-decoration: none; }
  .wordmark-link:hover { text-decoration: none; }

  .nav-divider { margin: 0; }

  .nav {
    display: flex;
    justify-content: center;
    gap: 28px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 700;
    padding: 12px 28px;
  }
  .nav a {
    color: var(--ink-dim);
    position: relative;
    padding-bottom: 3px;
    letter-spacing: 0.03em;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 1.5px;
    background: var(--core);
    transition: width 0.2s ease;
  }
  .nav a:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .nav a:hover::after { width: 100%; }

  @media (max-width: 560px) {
    .utility-bar { flex-direction: column; gap: 4px; padding: 8px 20px; text-align: center; }
    .nameplate-row { padding: 10px 20px 14px; }
    .nav { gap: 16px; font-size: 11.5px; flex-wrap: wrap; padding: 10px 20px; }
  }
</style>
