---
import Wordmark from './Wordmark.astro';

const nav = [
  { href: '/blog', label: 'Blog' },
  { href: '/rankings', label: 'Rankings' },
  { href: '/prompts', label: 'Prompts' },
  { href: '/repos', label: 'Repos' },
  { href: '/casos', label: 'Casos' },
  { href: '/sobre', label: 'Sobre' },
];

// Ticker "última hora" — mezcla editorial. Duplicado en track para loop sin costura.
const tickerItems = [
  'Salud IA',
  'Automatización',
  'IA General',
  'Menos hype, más iapo',
  'N°{n} · IA aplicada a lo que hacés hoy',
];
---
<header class="masthead">
  <div class="wrap utility-bar">
    <span class="mono util-item" id="utility-edition">EDICIÓN N°1 · AGO 2026</span>
    <span class="mono util-item util-locale">VIÑA DEL MAR, CHILE</span>
  </div>
  <div class="wrap nameplate-row">
    <a href="/" class="wordmark-link" aria-label="iapo.cl — inicio" transition:name="masthead-wordmark">
      <Wordmark size={38} />
    </a>
  </div>
  <div class="tear-line nav-divider"></div>
  <nav class="wrap nav">
    {nav.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
  </nav>
  <div class="ticker mast-ticker" aria-label="Última hora">
    <div class="ticker-track">
      {tickerItems.map((t) => <span class="ticker-item mono">{t}</span>)}
      {tickerItems.map((t) => <span class="ticker-item mono" aria-hidden="true">{t}</span>)}
    </div>
  </div>
</header>

<style>
  .masthead {
    background: var(--paper-raised);
    border-bottom: 1.5px solid var(--ink);
  }
  .utility-bar {
    display: flex;
    justify-content: space-between;
    padding: 10px 28px;
  }
  .util-item {
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }
  .util-locale { color: var(--core); font-weight: 700; }

  .nameplate-row {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 28px 18px;
  }
  .wordmark-link { text-decoration: none; }
  .wordmark-link:hover { text-decoration: none; }

  .nav-divider { margin: 0; }

  .nav {
    display: flex;
    justify-content: center;
    gap: 28px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 700;
    padding: 12px 28px;
  }
  .nav a {
    color: var(--ink-dim);
    position: relative;
    padding-bottom: 3px;
    letter-spacing: 0.03em;
  }
  .masthead .nav a::after,
  .masthead .nav a::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1.5px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s var(--ease-out), opacity 0.2s var(--ease-out);
  }
  .masthead .nav a::after {
    background: var(--comic-red);
    transition-delay: 0s;
  }
  .masthead .nav a::before {
    background: var(--core);
    transition-delay: 80ms;
  }
  .nav a:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .masthead .nav a:hover::after,
  .masthead .nav a:hover::before,
  .masthead .nav a:focus-visible::after,
  .masthead .nav a:focus-visible::before {
    transform: scaleX(1);
    opacity: 1;
  }

  .mast-ticker {
    background: var(--paper-raised);
    border-block: 1px solid var(--rule);
  }

  @media (hover: hover) and (pointer: fine) {
    .masthead .nav a::after,
    .masthead .nav a::before {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .masthead .nav a::after,
    .masthead .nav a::before {
      transform: scaleX(1);
      transition: none;
    }
    .mast-ticker .ticker-track {
      animation: none;
    }
    .mast-ticker .ticker-item {
      animation: none;
    }
  }

  @media (max-width: 560px) {
    .utility-bar { flex-direction: column; gap: 4px; padding: 8px 20px; text-align: center; }
    .nameplate-row { padding: 10px 20px 14px; }
    .nav { gap: 16px; font-size: 11.5px; flex-wrap: wrap; padding: 10px 20px; }
  }
</style>

<script>
  const firstPub = new Date('2026-08-14T00:00:00');
  function updateUtility() {
    const el = document.getElementById('utility-edition');
    if (!el) return;
    const now = new Date();
    const editionNum = Math.floor((now.getTime() - firstPub.getTime()) / (7 * 864e5)) + 1;
    const dt = new Intl.DateTimeFormat('es-CL', { month: 'long', year: 'numeric' }).format(now);
    const monthUpper = dt.replace(/^\d+\s+/, '').toUpperCase().trim();
    // Format: EDICIÓN N°{n} · {MES AÑO}
    const text = `EDICIÓN N°${editionNum} · ${monthUpper}`;
    if (el.textContent !== text) el.textContent = text;
    document.querySelectorAll('.ticker-item').forEach((item) => {
      if (item.textContent.includes('{n}')) {
        item.textContent = item.textContent.replace('{n}', editionNum);
      }
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateUtility, { once: true });
  } else {
    updateUtility();
  }
  document.addEventListener('astro:page-load', updateUtility);
</script>
