---
import Base from './Base.astro';
import Sidebar from '../components/Sidebar.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  pilar: 'salud' | 'automatizacion' | 'ia-general';
  allPosts?: CollectionEntry<'blog'>[];
  currentId?: string;
}

const { title, description, pubDate, pilar, allPosts = [], currentId } = Astro.props;
const pilarLabel = {
  salud: 'IA en salud',
  automatizacion: 'Automatización',
  'ia-general': 'IA general',
}[pilar];

const dateFmt = new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'long', year: 'numeric' }).format(pubDate);
const dateShort = (d: Date) => new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);

const postUrl = new URL(Astro.url.pathname, Astro.site).href;

const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${postUrl}#article`,
  headline: title,
  description,
  image: 'https://iapo.cl/og.png',
  author: { '@type': 'Organization', name: 'Aicore Agency', url: 'https://aicorebots.com' },
  publisher: { '@type': 'Organization', '@id': 'https://iapo.cl/#organization' },
  datePublished: pubDate.toISOString(),
  dateModified: pubDate.toISOString(),
  mainEntityOfPage: postUrl,
  inLanguage: 'es-CL',
};

const related = (() => {
  const samePilar = allPosts.filter((p) => p.id !== currentId && p.data.pilar === pilar);
  const others = allPosts.filter((p) => p.id !== currentId && p.data.pilar !== pilar);
  return [...samePilar, ...others].slice(0, 3);
})();
---
<Base
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={pubDate.toISOString()}
  author="Aicore Agency"
  structuredData={[blogPosting]}
>
  <div class="mag-grid">
    <main class="mag-main">
      <article class="post">
        <div class="post-meta">
          <span class="tag" data-pilar={pilar}>{pilarLabel}</span>
          <span class="eyebrow">{dateFmt}</span>
        </div>
        <div class="post-head">
          <h1>{title}</h1>
          <p class="deck">{description}</p>
        </div>
        <hr class="tear-line post-divider" />
        <div class="content prose-col">
          <slot />
        </div>
      </article>

      {related.length > 0 && (
        <section class="related" data-reveal>
          <h2 class="related-title">Artículos relacionados</h2>
          <div class="related-grid">
            {related.map((post) => (
              <a href={`/blog/${post.id}`} class="related-card panel">
                <span class="tag" data-pilar={post.data.pilar}>{pilarLabel[post.data.pilar]}</span>
                <span class="related-post-title">{post.data.title}</span>
                <span class="eyebrow related-date">{dateShort(post.data.pubDate)}</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </main>
    {allPosts.length > 0 && <Sidebar posts={allPosts} currentId={currentId} />}
  </div>
</Base>

<style>
  .mag-grid { display: grid; grid-template-columns: 1fr 300px; gap: 48px; align-items: start; margin-bottom: 60px; }
  .post { padding: 44px 0 0; }
  .post-meta { display: flex; gap: 12px; align-items: center; margin-bottom: 18px; }
  .post-head { margin-bottom: 14px; }
  .post-head h1 { font-size: clamp(1.9rem, 4.5vw, 2.5rem); margin: 0 0 14px; max-width: 22ch; }
  .deck { color: var(--ink-dim); font-size: 1.1rem; margin: 0; max-width: 56ch; }
  .post-divider { margin: 32px 0; }
  .content :global(h2) { margin-top: 2.4em; font-size: 1.4rem; font-weight: 500; }
  .content :global(h3) { margin-top: 1.9em; font-size: 1.15rem; font-weight: 500; }
  .content :global(p) { margin: 1.1em 0; }
  .content :global(ul), .content :global(ol) { padding-left: 1.4em; }
  .content :global(li) { margin: 0.45em 0; }
  .content :global(blockquote) {
    border-left: 3px solid var(--comic-red);
    margin: 1.6em 0;
    padding: 0.2em 0 0.2em 1.3em;
    color: var(--ink-dim);
    font-style: italic;
  }

  .related { margin: 8px 0 0; }
  .related-title { font-size: 1.2rem; margin: 0 0 18px; }
  .related-grid { display: grid; gap: 16px; }
  .related-card { display: flex; flex-direction: column; gap: 10px; padding: 20px 22px; color: var(--ink); text-decoration: none; }
  .related-card:hover { text-decoration: none; }
  .related-post-title { font-size: 1.02rem; line-height: 1.35; font-weight: 500; transition: color 0.15s ease; }
  .related-card:hover .related-post-title { color: var(--core); }
  .related-date { font-size: 10.5px; }

  @media (max-width: 880px) {
    .mag-grid { grid-template-columns: 1fr; }
  }
</style>