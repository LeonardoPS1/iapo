---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  pilar: 'salud' | 'automatizacion' | 'ia-general';
}

const { title, description, pubDate, pilar } = Astro.props;
const pilarLabel = {
  salud: 'IA en salud',
  automatizacion: 'Automatización',
  'ia-general': 'IA general',
}[pilar];

const dateFmt = new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'long', year: 'numeric' }).format(pubDate);
---
<Base title={title} description={description}>
  <article class="post">
    <div class="post-meta">
      <span class="tag" data-pilar={pilar}>{pilarLabel}</span>
      <span class="eyebrow">{dateFmt}</span>
    </div>
    <h1>{title}</h1>
    <p class="deck">{description}</p>
    <hr />
    <div class="content">
      <slot />
    </div>
  </article>
</Base>

<style>
  .post { padding: 40px 0 20px; }
  .post-meta { display: flex; gap: 12px; align-items: center; margin-bottom: 16px; }
  h1 { font-size: 2.1rem; margin: 0 0 12px; }
  .deck { color: var(--text-dim); font-size: 1.1rem; margin: 0; }
  .content :global(h2) { margin-top: 2.2em; font-size: 1.4rem; }
  .content :global(h3) { margin-top: 1.8em; font-size: 1.15rem; }
  .content :global(p) { margin: 1em 0; }
  .content :global(ul), .content :global(ol) { padding-left: 1.4em; }
  .content :global(li) { margin: 0.4em 0; }
  .content :global(blockquote) {
    border-left: 2px solid var(--accent);
    margin: 1.5em 0;
    padding: 0.2em 0 0.2em 1.2em;
    color: var(--text-dim);
  }
</style>
