---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  snapshotDate: Date;
  period: {
    repos: string;
    skills: string;
    mcp: string;
  };
}

const { title, description, pubDate, snapshotDate, period } = Astro.props;

const dateFmt = new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'long', year: 'numeric' }).format(pubDate);
const snapshotFmt = new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'long', year: 'numeric' }).format(snapshotDate);

const landingUrl = new URL(Astro.url.pathname, Astro.site).href;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${landingUrl}#article`,
  headline: title,
  description,
  image: 'https://iapo.cl/og.png',
  author: {
    '@type': 'Person',
    name: 'Aicore Agency',
    url: 'https://aicorebots.com',
    sameAs: ['https://aicorebots.com', 'https://med.aicorebots.com'],
  },
  publisher: { '@type': 'Organization', '@id': 'https://iapo.cl/#organization' },
  datePublished: pubDate.toISOString(),
  dateModified: snapshotDate.toISOString(),
  mainEntityOfPage: landingUrl,
  inLanguage: 'es-CL',
  temporalCoverage: period.repos,
  keywords: 'repos github, agent skills, mcp servers, ranking semanal, ia',
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.rank-head h1', '.rack', '.content > p:first-of-type'],
  },
};
---
<Base
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={snapshotDate.toISOString()}
  author="Aicore Agency"
  structuredData={[articleSchema]}
>
  <article class="rank">
    <div class="rank-meta">
      <span class="eyebrow rack-tag">// RANKING SEMANAL</span>
      <span class="eyebrow">{dateFmt}</span>
    </div>
    <div class="rank-head" data-print-in data-reveal>
      <h1>{title}</h1>
      <span class="stamp" data-reveal data-stamp aria-hidden="true">// TENDENCIAS</span>
      <p class="rack">{description}</p>
    </div>
    <hr class="tear-line rank-divider" />
    <div class="content prose-col">
      <slot />
    </div>
  </article>
</Base>

<style>
  .rank { padding: 44px 0 0; }
  .rank-meta { display: flex; gap: 12px; align-items: center; margin-bottom: 18px; }
  .rack-tag { color: var(--core); font-weight: 700; }
  .rank-head { position: relative; margin-bottom: 14px; }
  .rank-head h1 { font-size: clamp(1.9rem, 4.5vw, 2.5rem); margin: 0 0 14px; max-width: 24ch; }
  .rack { color: var(--ink-dim); font-size: 1.1rem; margin: 0; max-width: 56ch; }
  .stamp {
    position: absolute;
    top: 0;
    right: 0;
    font-family: var(--font-mono);
    font-size: 9px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--comic-red);
    border: 1.5px dashed var(--comic-red);
    border-radius: 3px;
    padding: 5px 8px 4px;
    background: var(--paper);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    z-index: 2;
  }
  .rank-divider { margin: 32px 0; }
  .content :global(h2) { margin-top: 2.4em; font-size: 1.4rem; font-weight: 500; }
  .content :global(h3) { margin-top: 1.9em; font-size: 1.15rem; font-weight: 500; }
  .content :global(p) { margin: 1.1em 0; }
  .content :global(ul), .content :global(ol) { padding-left: 1.4em; }
  .content :global(li) { margin: 0.45em 0; }
  .content :global(blockquote) {
    border-left: 3px solid var(--comic-red);
    margin: 1.6em 0;
    padding: 0.2em 0 0.2em 1.3em;
    color: var(--ink-dim);
    font-style: italic;
  }
  .content :global(a) { color: var(--core); }
</style>