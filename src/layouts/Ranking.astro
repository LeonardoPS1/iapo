---
import Base from './Base.astro';
import SectionScore from '../components/rank/SectionScore.astro';

interface RankItem {
  rank: number;
  name: string;
  url: string;
  metricNumber: number;
  metricDisplay: string;
  language?: string;
  origin?: string;
  description: string;
  why: string;
}

interface List {
  kind: 'repos' | 'skills' | 'mcp';
  label: string;
  window: string;
  source: string;
  items: RankItem[];
}

interface Method {
  windows: string[];
  warnings: string[];
  sources: { label: string; url: string }[];
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  snapshotDate: Date;
  edition: number;
  lists: List[];
  method: Method;
}

const { title, description, pubDate, snapshotDate, edition, lists, method } = Astro.props;

const dateFmt = new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'long', year: 'numeric' }).format(pubDate);
const snapshotFmt = new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'long', year: 'numeric' }).format(snapshotDate);

const landingUrl = new URL(Astro.url.pathname, Astro.site).href;

const totals = lists.map((l) => l.items.length).join(' · ');

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${landingUrl}#article`,
  headline: title,
  description,
  image: 'https://iapo.cl/og.png',
  author: {
    '@type': 'Person',
    name: 'Aicore Agency',
    url: 'https://aicorebots.com',
    sameAs: ['https://aicorebots.com', 'https://med.aicorebots.com'],
  },
  publisher: { '@type': 'Organization', '@id': 'https://iapo.cl/#organization' },
  datePublished: pubDate.toISOString(),
  dateModified: snapshotDate.toISOString(),
  mainEntityOfPage: landingUrl,
  inLanguage: 'es-CL',
  temporalCoverage: lists[0]?.window,
  keywords: 'repos github, agent skills, mcp servers, ranking semanal, ia',
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.rank-head h1', '.rack', '.score-summary'],
  },
};
---
<Base
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={snapshotDate.toISOString()}
  author="Aicore Agency"
  structuredData={[articleSchema]}
>
  <article class="rank">
    <div class="rank-meta">
      <span class="eyebrow rack-tag">// RANKING SEMANAL — EDICIÓN Nº{edition}</span>
      <span class="eyebrow">{dateFmt}</span>
    </div>
    <div class="rank-head" data-print-in data-reveal>
      <h1>{title}</h1>
      <span class="stamp" data-reveal data-stamp aria-hidden="true">// TENDENCIAS</span>
      <p class="rack">{description}</p>
    </div>

    <div class="score-summary panel" data-reveal>
      <span class="score-summary-total mono"><strong>{totals}</strong> puestos en esta edición</span>
      <span class="score-summary-date mono">Snapshot: {snapshotFmt}</span>
    </div>

    {lists.map((list) => <SectionScore kind={list.kind} label={list.label} window={list.window} source={list.source} items={list.items} />)}

    <hr class="tear-line rank-divider" />

    <details class="method" data-reveal>
      <summary class="method-summary">
        <span class="eyebrow">// Fuentes y metodología</span>
        <span class="method-chev mono" aria-hidden="true">+</span>
      </summary>
      <div class="method-body prose-col">
        <ul class="method-windows">
          {method.windows.map((w) => <li>{w}</li>)}
        </ul>
        <ul class="method-warnings">
          {method.warnings.map((w) => <li>{w}</li>)}
        </ul>
        <ul class="method-sources">
          {method.sources.map((s) => <li><a href={s.url}>{s.label}</a></li>)}
        </ul>
        <p class="method-cta">
          <em>Si te sirvió, <a href="/#suscribir">suscribite al diario</a> para no perderte el próximo ranking.</em>
        </p>
      </div>
    </details>
  </article>
</Base>

<style>
  .rank { padding: 44px 0 0; }
  .rank-meta { display: flex; gap: 12px; align-items: center; margin-bottom: 18px; flex-wrap: wrap; }
  .rack-tag { color: var(--core); font-weight: 700; }
  .rank-head { position: relative; margin-bottom: 14px; }
  .rank-head h1 { font-size: clamp(1.9rem, 4.5vw, 2.5rem); margin: 0 0 14px; max-width: 24ch; }
  .rack { color: var(--ink-dim); font-size: 1.1rem; margin: 0; max-width: 56ch; }
  .stamp {
    position: absolute;
    top: 0;
    right: 0;
    font-family: var(--font-mono);
    font-size: 9px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--comic-red);
    border: 1.5px dashed var(--comic-red);
    border-radius: 3px;
    padding: 5px 8px 4px;
    background: var(--paper);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    z-index: 2;
  }

  .score-summary {
    display: flex; align-items: baseline; gap: 20px; flex-wrap: wrap;
    padding: 14px 20px; margin: 8px 0 6px;
  }
  .score-summary-total { font-size: 0.95rem; }
  .score-summary-total strong { color: var(--core); }
  .score-summary-date { color: var(--ink-dim); font-size: 11.5px; margin-left: auto; }

  .rank-divider { margin: 44px 0 10px; }

  .method { margin-top: 20px; border: 1px solid var(--rule); border-radius: 8px; background: var(--paper-raised); padding: 0; }
  .method-summary {
    display: flex; align-items: center; gap: 12px;
    padding: 16px 20px;
    cursor: pointer;
    list-style: none;
  }
  .method-summary::-webkit-details-marker { display: none; }
  .method-chev {
    margin-left: auto;
    font-size: 1.2rem;
    color: var(--core);
    transition: transform 0.25s var(--ease-out);
  }
  .method[open] .method-chev { transform: rotate(45deg); }
  .method-body { padding: 0 20px 18px; }
  .method-windows, .method-warnings, .method-sources { margin: 0 0 14px; padding: 0; list-style: none; }
  .method-windows li, .method-warnings li, .method-sources li { margin: 8px 0; color: var(--ink-dim); line-height: 1.6; }
  .method-windows li::before { content: '1.'; font-family: var(--font-mono); color: var(--core); margin-right: 8px; }
  .method-warnings li::before { content: '!'; font-family: var(--font-mono); color: var(--comic-red); margin-right: 8px; font-weight: 700; }
  .method-sources li::before { content: '→'; font-family: var(--font-mono); color: var(--ia-general); margin-right: 8px; }
  .method-sources a { color: var(--core); }
  .method-cta { color: var(--ink-dim); font-size: 1rem; }
</style>