---
import Base from './Base.astro';
import SectionScore from '../components/rank/SectionScore.astro';

interface RankItem {
  rank: number;
  name: string;
  url: string;
  metricNumber: number;
  metricDisplay: string;
  language?: string;
  origin?: string;
  description: string;
  why: string;
}

interface List {
  kind: 'repos' | 'skills' | 'mcp';
  label: string;
  window: string;
  source: string;
  items: RankItem[];
}

interface Method {
  windows: string[];
  warnings: string[];
  sources: { label: string; url: string }[];
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  snapshotDate: Date;
  edition: number;
  lists: List[];
  method: Method;
}

const { title, description, pubDate, snapshotDate, edition, lists, method } = Astro.props;

const dateFmt = new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'long', year: 'numeric' }).format(pubDate);
const snapshotFmt = new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'long', year: 'numeric' }).format(snapshotDate);

const landingUrl = new URL(Astro.url.pathname, Astro.site).href;

const totals = lists.map((l) => l.items.length).join(' · ');

const KIND_COLOR = {
  repos: 'var(--core)',
  skills: 'var(--comic-red)',
  mcp: 'var(--ia-general)',
} as const;

const navShort = {
  repos: 'Repos',
  skills: 'Skills',
  mcp: 'MCP',
} as const;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${landingUrl}#article`,
  headline: title,
  description,
  image: 'https://iapo.cl/og.png',
  author: {
    '@type': 'Person',
    name: 'Aicore Agency',
    url: 'https://aicorebots.com',
    sameAs: ['https://aicorebots.com', 'https://med.aicorebots.com'],
  },
  publisher: { '@type': 'Organization', '@id': 'https://iapo.cl/#organization' },
  datePublished: pubDate.toISOString(),
  dateModified: snapshotDate.toISOString(),
  mainEntityOfPage: landingUrl,
  inLanguage: 'es-CL',
  temporalCoverage: lists[0]?.window,
  keywords: 'repos github, agent skills, mcp servers, ranking semanal, ia',
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.rank-head h1', '.rack', '.score-summary'],
  },
};
---
<Base
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={snapshotDate.toISOString()}
  author="Aicore Agency"
  structuredData={[articleSchema]}
>
  <article class="rank">
    <header class="rank-head" data-print-in data-reveal>
      <div class="rank-meta">
        <span class="rank-edition mono"><span class="ed-dot" aria-hidden="true"></span>EDICIÓN Nº{edition}</span>
        <span class="eyebrow rank-date">{dateFmt}</span>
      </div>
      <h1>{title}</h1>
      <span class="stamp" data-reveal data-stamp aria-hidden="true">// TENDENCIAS</span>
      <p class="rack">{description}</p>
    </header>

    <nav class="rank-nav" data-reveal aria-label="Secciones del ranking">
      {lists.map((list) => (
        <a class="rank-nav-item mono" href={`#${list.kind}`} style={`--kind:${KIND_COLOR[list.kind]}`}>
          <span class="nav-dot" aria-hidden="true"></span>{navShort[list.kind]}
        </a>
      ))}
      <a class="rank-nav-item mono rank-nav-method" href="#metodo">Metodología</a>
    </nav>

    <div class="score-summary panel" data-reveal>
      <div class="score-summary-cell">
        <span class="score-summary-n mono">{totals}</span>
        <span class="score-summary-label mono">puestos entre los tres mercados</span>
      </div>
      <div class="score-summary-cell score-summary-snap">
        <span class="score-summary-date mono">SNAPSHOT</span>
        <span class="score-summary-label mono">{snapshotFmt}</span>
      </div>
    </div>

    {lists.map((list) => (
      <SectionScore kind={list.kind} label={list.label} window={list.window} source={list.source} items={list.items} />
    ))}

    <hr class="tear-line rank-divider" />

    <details class="method" id="metodo" data-reveal>
      <summary class="method-summary">
        <span class="eyebrow">// Fuentes y metodología</span>
        <span class="method-chev mono" aria-hidden="true">+</span>
      </summary>
      <div class="method-body prose-col">
        <ul class="method-windows">
          {method.windows.map((w) => <li>{w}</li>)}
        </ul>
        <ul class="method-warnings">
          {method.warnings.map((w) => <li>{w}</li>)}
        </ul>
        <ul class="method-sources">
          {method.sources.map((s) => <li><a href={s.url}>{s.label}</a></li>)}
        </ul>
        <p class="method-cta">
          <em>Si te sirvió, <a href="/#suscribir">suscribite al diario</a> para no perderte el próximo ranking.</em>
        </p>
      </div>
    </details>
  </article>
</Base>

<style>
  .rank { padding: 40px 0 0; }

  /* ===== Hero del ranking ===== */
  .rank-head { position: relative; margin-bottom: 24px; }
  .rank-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .rank-edition {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--core);
    background: color-mix(in srgb, var(--core) 9%, var(--paper-raised));
    border: 1px solid color-mix(in srgb, var(--core) 28%, transparent);
    border-radius: 999px;
    padding: 5px 12px;
  }
  .ed-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--core);
    animation: live-pulse 2s var(--ease-in-out) infinite;
  }
  @keyframes live-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.8); }
  }
  .rank-date { color: var(--ink-faint); }

  .rank-head h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 6px;
    max-width: 22ch;
  }
  .rack {
    color: var(--ink-dim);
    font-size: 1.15rem;
    line-height: 1.6;
    margin: 0;
    max-width: 62ch;
  }
  .stamp {
    position: absolute;
    top: -6px;
    right: 0;
    font-family: var(--font-mono);
    font-size: 10px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--comic-red);
    border: 1.5px dashed var(--comic-red);
    border-radius: 4px;
    padding: 6px 10px 5px;
    background: var(--paper);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    z-index: 2;
    transform: rotate(-2deg);
  }

  /* ===== Nav sticky por secciones ===== */
  .rank-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    gap: 24px;
    align-items: center;
    padding: 12px 4px;
    margin-bottom: 24px;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1.5px solid var(--rule);
    scroll-margin-top: 0;
  }
  .rank-nav-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ink-dim);
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .nav-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--kind);
  }
  .rank-nav-item:hover { color: var(--ink); border-bottom-color: var(--kind); text-decoration: none; }
  .rank-nav-item:focus-visible { outline: 2px solid var(--core); outline-offset: 2px; border-radius: 2px; }
  .rank-nav-method { border-bottom-color: var(--ink-faint); }
  .rank-nav-method:hover { border-bottom-color: var(--ink); }

  /* ===== Resumen 5·5·5 ===== */
  .score-summary {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px 24px;
    align-items: center;
    padding: 18px 22px;
    margin-bottom: 30px;
    background:
      radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--core) 10%, transparent) 0 120px, transparent 121px),
      var(--paper-raised);
  }
  .score-summary-cell { display: flex; flex-direction: column; gap: 3px; }
  .score-summary-n {
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1;
    color: var(--core);
  }
  .score-summary-snap { text-align: right; }
  .score-summary-date {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--comic-red);
  }
  .score-summary-label {
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-dim);
  }

  .rank-divider { margin: 46px 0 10px; }

  /* ===== Método ===== */
  .method {
    margin-top: 20px;
    border: 1px dashed var(--ink-faint);
    border-radius: 8px;
    background: var(--paper-raised);
    padding: 0;
  }
  .method-summary {
    display: flex; align-items: center; gap: 12px;
    padding: 16px 20px;
    cursor: pointer;
    list-style: none;
  }
  .method-summary::-webkit-details-marker { display: none; }
  .method-chev {
    margin-left: auto;
    font-size: 1.2rem;
    color: var(--core);
    transition: transform 0.25s var(--ease-out);
  }
  .method[open] .method-chev { transform: rotate(45deg); }
  .method-body { padding: 0 20px 18px; }
  .method-windows, .method-warnings, .method-sources { margin: 0 0 14px; padding: 0; list-style: none; }
  .method-windows li, .method-warnings li, .method-sources li { margin: 8px 0; color: var(--ink-dim); line-height: 1.6; }
  .method-windows li::before { content: '1.'; font-family: var(--font-mono); color: var(--core); margin-right: 8px; }
  .method-warnings li::before { content: '!'; font-family: var(--font-mono); color: var(--comic-red); margin-right: 8px; font-weight: 700; }
  .method-sources li::before { content: '→'; font-family: var(--font-mono); color: var(--ia-general); margin-right: 8px; }
  .method-sources a { color: var(--core); }
  .method-cta { color: var(--ink-dim); font-size: 1rem; }

  @media (prefers-reduced-motion: reduce) {
    .ed-dot { animation: none; }
    .stamp { transform: none; }
    .rank-nav { backdrop-filter: none; background: var(--paper); }
  }

  @media (max-width: 620px) {
    .rank { padding-top: 24px; }
    .rank-head h1 { font-size: 1.9rem; max-width: 20ch; }
    .stamp { top: -8px; }
    .score-summary { grid-template-columns: 1fr; }
    .score-summary-snap { text-align: left; }
    .rank-nav { gap: 14px; overflow-x: auto; scrollbar-width: none; }
    .rank-nav::-webkit-scrollbar { display: none; }
  }
</style>